---
import Layout from '../../layouts/Layout.astro';
import AdSlot from '../../components/AdSlot.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import Icon from '../../components/Icon.astro';
import LegalSources from '../../components/LegalSources.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
import { calculateNetSalary } from '../../lib/calculations';
import { formatMoney } from '../../lib/format';

const path = '/calculadoras/salario-neto/';
const examples = [650, 800, 1000, 1200, 1500, 2000, 3000, 5000].map(grossPerPay => calculateNetSalary({ grossPerPay, frequency: 'monthly' }));
const faq = [
  { q: '¿Cuánto me descuentan del salario en Panamá?', a: 'El trabajador aporta 9.75% de Seguro Social y 1.25% de Seguro Educativo sobre su salario. Además, si su ingreso anual proyectado (incluido el décimo tercer mes) supera B/.11,000, el empleador retiene impuesto sobre la renta.' },
  { q: '¿A partir de qué salario se paga impuesto sobre la renta?', a: 'Con 13 pagos al año (12 salarios más el décimo), un salario mensual fijo de hasta B/.846.15 queda por debajo de B/.11,000 anuales y no genera ISR. A partir de ahí se paga 15% sobre el excedente, y 25% sobre lo que supere B/.50,000 al año.' },
  { q: '¿Por qué la calculadora multiplica por 13 y no por 12?', a: 'El décimo tercer mes es renta gravable para el ISR, así que la proyección anual del empleador lo incluye. Si en tu caso no corresponde (por ejemplo, empezaste a mitad de año), desmarca la opción y verás la estimación sin él.' },
  { q: '¿Las cuotas de Seguro Social reducen el ISR?', a: 'No. Las cuotas del Seguro Social no son deducibles para el impuesto sobre la renta y la deducción del Seguro Educativo fue derogada en 2010 (Decreto Ejecutivo 98). Por eso el ISR se calcula sobre el ingreso bruto.' },
  { q: '¿Por qué mi talonario no coincide exactamente?', a: 'La retención real usa las tablas de la DGI y puede reflejar deducciones personales declaradas (intereses hipotecarios, gastos médicos o educativos, declaración conjunta), ajustes de meses anteriores, otros empleadores o descuentos voluntarios como préstamos y cuotas sindicales.' },
  { q: '¿Se guarda mi salario?', a: 'No. El cálculo ocurre en tu teléfono o computadora y no se envía a ningún servidor.' }
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Calculadora de salario neto Panamá',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  inLanguage: 'es-PA',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }
};
---
<Layout title="Calculadora de salario neto Panamá 2026: CSS, Seguro Educativo e ISR" description="Calcula tu salario neto en Panamá: descuento de Seguro Social (9.75%), Seguro Educativo (1.25%) e ISR con el décimo incluido. Mensual, quincenal o semanal, con desglose y gráfico." canonicalPath={path} schema={schema}>
  <header class="page-head container">
    <Breadcrumbs items={[{ label: 'Salario neto', path }]} />
    <span class="eyebrow">Calculadora laboral</span>
    <h1>Calculadora de salario neto</h1>
    <p>Descubre cuánto recibes de verdad después de Seguro Social, Seguro Educativo e impuesto sobre la renta.</p>
  </header>

  <div class="container calculator-shell">
    <form class="panel" id="salary-form" novalidate>
      <h2>Tu salario</h2>
      <div class="form-grid">
        <div class="field full">
          <span class="field-label" id="frequency-label">Frecuencia de pago</span>
          <fieldset class="segmented" aria-labelledby="frequency-label" aria-describedby="frequency-help">
            <label><input type="radio" name="frequency" value="monthly" checked />Mensual</label>
            <label><input type="radio" name="frequency" value="fortnightly" />Quincenal</label>
            <label><input type="radio" name="frequency" value="biweekly" />Bisemanal</label>
            <label><input type="radio" name="frequency" value="weekly" />Semanal</label>
          </fieldset>
        </div>
        <div class="field full">
          <label for="gross">Salario bruto por pago</label>
          <div class="input-wrap"><span class="prefix">B/.</span><input id="gross" name="gross" type="number" min="0.01" step="0.01" inputmode="decimal" required placeholder="1,500.00" autocomplete="off" /></div>
          <small id="frequency-help">Lo que dice tu contrato antes de descuentos. Quincenal = 24 pagos al año; bisemanal = 26 (cada dos semanas).</small>
        </div>
        <details class="more field full">
          <summary>Comisiones y opciones</summary>
          <div class="form-grid">
            <div class="field full">
              <label for="other">Otros ingresos gravables por pago</label>
              <div class="input-wrap"><span class="prefix">B/.</span><input id="other" name="other" type="number" min="0" step="0.01" inputmode="decimal" placeholder="0.00" /></div>
              <small>Comisiones, bonificaciones o sobretiempo habitual sujetos a cuotas e ISR.</small>
            </div>
            <label class="check field full"><input type="checkbox" name="thirteenth" checked /><span><strong>Incluir el décimo tercer mes en la proyección del ISR.</strong> Es lo habitual en la planilla; desmárcalo si este año no recibirás las tres partidas.</span></label>
          </div>
        </details>
      </div>
      <p class="form-error" id="salary-error" role="alert"></p>
      <button class="calculate" type="submit">Calcular salario neto</button>
    </form>

    <section class="panel results" id="salary-results" aria-live="polite" aria-label="Resultado">
      <div id="salary-empty" class="empty-state"><Icon name="salary" size={40} /><p>Escribe tu salario bruto y pulsa <strong>Calcular</strong> para ver el desglose.</p></div>
      <div id="salary-result" hidden>
        <div class="result-hero">
          <div class="label">Salario neto estimado <span data-out="frequencyLabel"></span></div>
          <div class="amount" data-out="net">B/. 0.00</div>
          <div class="sub">Te descuentan <strong data-out="totalDeductions"></strong> (<span data-out="deductionRate"></span> del bruto)</div>
        </div>
        <div id="salary-bar"></div>
        <ul class="breakdown">
          <li><span>Salario bruto</span><strong data-out="gross"></strong></li>
          <li class="minus"><span>Seguro Social <small>9.75% (CSS)</small></span><strong data-out="socialSecurity"></strong></li>
          <li class="minus"><span>Seguro Educativo <small>1.25%</small></span><strong data-out="educationalInsurance"></strong></li>
          <li class="minus"><span>Impuesto sobre la renta <small data-out="isrNote"></small></span><strong data-out="incomeTax"></strong></li>
          <li class="total"><span>Neto por pago</span><strong data-out="net"></strong></li>
        </ul>
        <div class="mini-stats">
          <div><span>Neto mensual equivalente</span><strong data-out="netMonthlyEquivalent"></strong></div>
          <div><span>Ingreso anual proyectado</span><strong data-out="projectedAnnualIncome"></strong></div>
          <div><span>ISR anual estimado</span><strong data-out="annualIncomeTax"></strong></div>
          <div><span>Tasa marginal de ISR</span><strong data-out="marginalTaxRate"></strong></div>
        </div>
        <div class="result-actions">
          <button class="button secondary" type="button" id="salary-share"><Icon name="share" size={18} />Compartir</button>
          <a class="button secondary" href="#como-se-calcula">Ver fórmula</a>
        </div>
        <p class="callout info">Estimación para un solo empleador sin deducciones personales. Tu retención real sigue las tablas de la DGI y puede variar.</p>
      </div>
    </section>
  </div>

  <div class="container"><AdSlot name="afterResult" /></div>

  <article class="container article">
    <h2 id="como-se-calcula">¿Cómo se calcula el salario neto en Panamá?</h2>
    <p>Del salario bruto se restan tres conceptos. Los dos primeros son porcentajes fijos de cada pago; el tercero depende de lo que ganarás en todo el año.</p>
    <ol>
      <li><strong>Seguro Social (CSS): 9.75%</strong> del salario, según el artículo 101 de la Ley 51 de 2005. La reforma de la Ley 462 de 2025 subió la cuota del empleador, no la del trabajador.</li>
      <li><strong>Seguro Educativo: 1.25%</strong> del salario. No se aplica al décimo tercer mes.</li>
      <li><strong>Impuesto sobre la renta (ISR):</strong> se proyecta el ingreso del año, 12 salarios más el décimo (13 en total), y se aplica la tarifa del artículo 700 del Código Fiscal. El impuesto anual se reparte de forma proporcional entre los pagos.</li>
    </ol>
    <p class="formula">ISR anual = 0 hasta B/.11,000 · 15% sobre el excedente de B/.11,000 hasta B/.50,000 · B/.5,850 + 25% sobre el excedente de B/.50,000</p>
    <p class="formula">Neto = bruto − 9.75% − 1.25% − (bruto × ISR anual ÷ ingreso anual proyectado)</p>

    <h3>Ejemplo con B/.1,500 mensuales</h3>
    <p>Ingreso anual proyectado: 1,500 × 13 = B/.19,500. Excedente sobre B/.11,000: B/.8,500. ISR anual: 15% de 8,500 = B/.1,275, que equivale a B/.98.08 por cada pago de B/.1,500. Con B/.146.25 de Seguro Social y B/.18.75 de Seguro Educativo, el neto queda en <strong>B/.1,236.92</strong>.</p>

    <h2>Tabla de salario neto mensual en Panamá</h2>
    <p>Estimaciones para un salario mensual fijo, con el décimo incluido en la proyección del ISR y sin deducciones personales.</p>
    <div class="table-wrap">
      <table>
        <caption>Calculado con los parámetros vigentes revisados en esta página.</caption>
        <thead><tr><th scope="col">Bruto</th><th scope="col">CSS</th><th scope="col">S. Educ.</th><th scope="col">ISR</th><th scope="col">Neto</th></tr></thead>
        <tbody>
          {examples.map(row => (
            <tr><th scope="row">{formatMoney(row.gross)}</th><td>{formatMoney(row.socialSecurity)}</td><td>{formatMoney(row.educationalInsurance)}</td><td>{formatMoney(row.incomeTax)}</td><td><strong>{formatMoney(row.net)}</strong></td></tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2>Lo que esta calculadora no incluye</h2>
    <ul>
      <li>Deducciones personales del ISR: intereses hipotecarios o educativos, gastos médicos, primas de seguro de salud, aportes a fondos de pensión o la deducción por declaración conjunta.</li>
      <li>Ingresos de otros empleadores, gastos de representación, que tienen su propia retención, ni ajustes de la declaración anual.</li>
      <li>Descuentos voluntarios o judiciales: préstamos, cuotas sindicales, pensiones alimenticias o embargos.</li>
      <li>Topes, exenciones o tratamientos especiales de casos particulares.</li>
    </ul>

    <Faq items={faq} />
    <LegalSources sources={['css', 'incomeTax', 'mitradel']} />
  </article>

  <div class="container"><RelatedCalculators current={path} /></div>
</Layout>

<script>
  import { calculateNetSalary, type Frequency } from '../../lib/calculations';
  import { formatMoney, formatPercent } from '../../lib/format';
  import { $, bindCalculator, bindShare, readNumber, readText, renderBar, setOutputs } from '../../lib/ui';

  const labels: Record<Frequency, string> = { monthly: 'por mes', fortnightly: 'por quincena', biweekly: 'cada dos semanas', weekly: 'por semana' };
  const result = $('#salary-result');
  let summary = '';

  bindCalculator({
    form: $<HTMLFormElement>('#salary-form'),
    error: $('#salary-error'),
    empty: $('#salary-empty'),
    result,
    run(data) {
      const gross = readNumber(data, 'gross');
      const other = readNumber(data, 'other') ?? 0;
      if (gross === undefined || !(gross > 0)) return 'Escribe un salario bruto mayor que cero.';
      if (!(other >= 0)) return 'Los otros ingresos no pueden ser negativos.';
      const frequency = readText(data, 'frequency') as Frequency;
      const out = calculateNetSalary({ grossPerPay: gross, frequency, otherPerPay: other, includeThirteenth: data.get('thirteenth') === 'on' });
      setOutputs(result, {
        frequencyLabel: labels[frequency],
        net: formatMoney(out.net),
        totalDeductions: formatMoney(out.totalDeductions),
        deductionRate: formatPercent(out.totalDeductions / out.gross),
        gross: formatMoney(out.gross),
        socialSecurity: formatMoney(out.socialSecurity),
        educationalInsurance: formatMoney(out.educationalInsurance),
        incomeTax: formatMoney(out.incomeTax),
        isrNote: out.incomeTax > 0 ? `${formatPercent(out.effectiveTaxRate)} efectivo` : 'no aplica bajo B/.11,000 al año',
        netMonthlyEquivalent: formatMoney(out.netMonthlyEquivalent),
        projectedAnnualIncome: formatMoney(out.projectedAnnualIncome),
        annualIncomeTax: formatMoney(out.annualIncomeTax),
        marginalTaxRate: formatPercent(out.marginalTaxRate)
      });
      renderBar($('#salary-bar'), [
        { label: 'Neto', value: out.net, tone: 'net' },
        { label: 'Seguro Social', value: out.socialSecurity, tone: 'css' },
        { label: 'Seguro Educativo', value: out.educationalInsurance, tone: 'edu' },
        { label: 'ISR', value: out.incomeTax, tone: 'isr' }
      ], formatMoney);
      summary = `Salario bruto ${formatMoney(out.gross)} ${labels[frequency]} → neto estimado ${formatMoney(out.net)} (CSS ${formatMoney(out.socialSecurity)}, Seguro Educativo ${formatMoney(out.educationalInsurance)}, ISR ${formatMoney(out.incomeTax)}). Calculado en Calcula Panamá.`;
    }
  });
  bindShare($<HTMLButtonElement>('#salary-share'), () => summary);
</script>
