---
import Layout from '../../layouts/Layout.astro';
import FxCrumb from '../../components/fx/FxCrumb.astro';
import FxIcon from '../../components/fx/FxIcon.astro';
import FxDonut from '../../components/fx/FxDonut.astro';
import Faq from '../../components/Faq.astro';
import LegalSources from '../../components/LegalSources.astro';
import { calculateNetSalary } from '../../lib/calculations';
import { formatMoney } from '../../lib/format';

const path = '/calculadoras/salario-neto/';
const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}${p.replace(/^\//, '')}`;
const related = [
  { label: 'Mi Quincena', path: '/finanzas/mi-quincena/', icon: 'calendar' },
  { label: 'Décimo tercer mes', path: '/calculadoras/decimo-tercer-mes/', icon: 'calendar' },
  { label: 'Vacaciones', path: '/calculadoras/vacaciones/', icon: 'calendar' },
  { label: 'Liquidación laboral', path: '/calculadoras/liquidacion-laboral/', icon: 'receipt' },
  { label: 'Horas extras', path: '/calculadoras/horas-extras/', icon: 'clock' }
] as const;
const examples = [650, 800, 1000, 1200, 1500, 2000, 3000, 5000].map(grossPerPay => calculateNetSalary({ grossPerPay, frequency: 'monthly' }));
const faq = [
  { q: '¿Cuánto me descuentan del salario en Panamá?', a: 'El trabajador aporta 9.75% de Seguro Social y 1.25% de Seguro Educativo sobre su salario. Además, si su ingreso anual proyectado (incluido el décimo tercer mes) supera B/.11,000, el empleador retiene impuesto sobre la renta.' },
  { q: '¿A partir de qué salario se paga impuesto sobre la renta?', a: 'En la proyección de esta calculadora, con salario fijo durante todo el año, 12 salarios y un décimo equivalente, y sin deducciones personales, hasta B/.846.15 mensuales queda por debajo de B/.11,000 anuales. La tarifa se aplica sobre la renta gravable: las deducciones y circunstancias personales pueden cambiar el resultado.' },
  { q: '¿Por qué la calculadora multiplica por 13 y no por 12?', a: 'El décimo tercer mes es renta gravable para el ISR, así que la proyección anual del empleador lo incluye. Si en tu caso no corresponde (por ejemplo, empezaste a mitad de año), desmarca la opción y verás la estimación sin él.' },
  { q: '¿Las cuotas de Seguro Social reducen el ISR?', a: 'No. Las cuotas del Seguro Social no son deducibles para el impuesto sobre la renta y la deducción del Seguro Educativo fue derogada en 2010 (Decreto Ejecutivo 98). Por eso el ISR se calcula sobre el ingreso bruto.' },
  { q: '¿Qué deducciones reducen el ISR de un asalariado?', a: 'Las que declares a tu empleador y él compruebe (Código Fiscal, arts. 704 y 709): B/.800 si declaras en forma conjunta con tu cónyuge, intereses hipotecarios de tu vivienda principal, intereses de préstamos educativos, primas de seguro de hospitalización y aportes a fondos de pensiones. Puedes indicarlas en «Comisiones, deducciones y opciones».' },
  { q: '¿El ISR anual y la retención de cada pago son lo mismo?', a: 'No exactamente. La retención es un anticipo: el empleador reparte el impuesto anual estimado entre los pagos. Si tu salario cambia, tus comisiones varían o trabajas solo parte del año, el empleador recalcula y, al cierre, la diferencia se ajusta como crédito o como retención adicional (Decreto Ejecutivo 170 de 1993).' },
  { q: '¿Por qué mi talonario no coincide exactamente?', a: 'La retención real sigue las tablas e instrucciones de la DGI y puede reflejar ajustes de meses anteriores, aumentos, otros empleadores, redondeos o descuentos voluntarios como préstamos y cuotas sindicales.' },
  { q: '¿Se guarda mi salario?', a: 'No. El cálculo ocurre en tu teléfono o computadora y no se envía a ningún servidor.' }
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Calculadora de salario neto Panamá',
  url: new URL(path, Astro.site ?? Astro.url.origin).toString(),
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  inLanguage: 'es-PA',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }
};
---
<Layout title="Calculadora de salario neto en Panamá | CSS e ISR" description="Estima tu salario neto mensual, quincenal o semanal en Panamá. Consulta el desglose de Seguro Social, Seguro Educativo e ISR y los supuestos del cálculo." canonicalPath={path} schema={schema} variant="functional">
<div class="fx-wrap">
  <FxCrumb items={[{ label: 'Salario neto', path }]} category={{ label: 'Trabajo', path: '/herramientas/#trabajo' }} />
  <div class="fx-title"><FxIcon name="wallet" size={22} framed class="is-lg" /><h1><span class="visually-hidden">Calculadora de </span><span class="fx-cap">salario neto</span></h1></div>
  <p class="fx-lede">Descubre cuánto recibes de verdad después de Seguro Social, Seguro Educativo e impuesto sobre la renta.</p>

  <div class="fx-tool fx-salary">
    <div class="fx-contents" id="salary-results">
      <section class="fx-panel fx-o1" id="salary-empty" aria-label="Resultado">
        <span class="fx-overline">Salario neto</span>
        <span class="fx-amount" aria-hidden="true">B/. —</span>
        <p class="fx-sub">Escribe tu salario bruto y pulsa <strong>Calcular salario neto</strong> para ver el desglose.</p>
      </section>
      <div class="fx-contents" id="salary-result" hidden>
        <section class="fx-panel fx-o1" id="salary-hero" aria-label="Resultado" aria-live="polite">
          <span class="fx-overline">Salario neto <span data-out="frequencyLabel"></span></span>
          <strong class="fx-amount" data-out="net">B/. 0.00</strong>
          <p class="fx-sub">Te descuentan <strong data-out="totalDeductions"></strong> (<span data-out="deductionRate"></span> del bruto)</p>
          <div class="fx-hero-split">
            <FxDonut id="salary-donut" label="Porcentaje del salario disponible" caption="Disponible" />
            <div class="fx-stats">
              <div class="fx-stat"><span><FxIcon name="banknote" size={16} />Salario bruto</span><strong data-out="gross"></strong></div>
              <div class="fx-stat"><span><FxIcon name="arrowUpRight" size={16} />Descuentos</span><strong data-out="totalDeductions"></strong></div>
            </div>
          </div>
        </section>

        <section class="fx-panel fx-o3" aria-labelledby="breakdown-title">
          <h2 class="fx-panel-title" id="breakdown-title">Descuentos aplicados</h2>
          <div class="fx-split" id="salary-split" role="img" aria-label=""></div>
          <ul class="fx-legend" id="salary-legend"></ul>
          <ul class="fx-rows" style="margin-top:14px">
            <li><FxIcon name="shield" framed /><span class="fx-row-label">Seguro Social<small>9.75% (CSS)</small></span><strong>−<span data-out="socialSecurity"></span></strong></li>
            <li><FxIcon name="graduation" framed /><span class="fx-row-label">Seguro Educativo<small>1.25%</small></span><strong>−<span data-out="educationalInsurance"></span></strong></li>
            <li><FxIcon name="bank" framed /><span class="fx-row-label">Impuesto sobre la renta<small data-out="isrNote"></small></span><strong>−<span data-out="incomeTax"></span></strong></li>
            <li class="is-total"><span class="fx-row-label">Total descontado</span><strong data-out="totalDeductions"></strong></li>
            <li class="is-total"><span class="fx-row-label">Neto por pago</span><strong data-out="net"></strong></li>
          </ul>
        </section>

        <section class="fx-panel fx-o4" aria-labelledby="annual-title">
          <h2 class="fx-panel-title" id="annual-title">Proyección anual</h2>
          <div class="fx-stats fx-stats-compact" style="margin-top:0">
            <div class="fx-stat"><span>Neto mensual equivalente</span><strong data-out="netMonthlyEquivalent"></strong></div>
            <div class="fx-stat"><span>Ingreso anual proyectado</span><strong data-out="projectedAnnualIncome"></strong></div>
            <div class="fx-stat"><span>Renta gravable anual</span><strong data-out="taxableAnnual"></strong></div>
            <div class="fx-stat"><span>ISR anual estimado</span><strong data-out="annualIncomeTax"></strong></div>
            <div class="fx-stat"><span>Tasa marginal de ISR</span><strong data-out="marginalTaxRate"></strong></div>
            <div class="fx-stat"><span>Deducciones aplicadas</span><strong data-out="annualDeductions"></strong></div>
          </div>
          <p class="fx-hint" style="margin-top:14px">Estimación orientativa para un solo empleador y un ingreso estable todo el año. La retención real sigue las tablas de la DGI, se recalcula si cambia tu salario y se ajusta al cierre del año.</p>
        </section>

        <div class="fx-o5">
          <div class="fx-actions" role="group" aria-label="Acciones del resultado">
            <button class="fx-action" type="button" id="salary-copy"><FxIcon name="copy" size={20} />Copiar</button>
            <button class="fx-action" type="button" id="salary-share"><FxIcon name="share" size={20} />Compartir</button>
            <button class="fx-action" type="button" id="salary-reset"><FxIcon name="reset" size={20} />Reiniciar</button>
          </div>
          <p class="fx-status" id="salary-action-status" role="status"></p>
        </div>
      </div>
    </div>

    <form class="fx-panel fx-form fx-col-side fx-o2" id="salary-form" novalidate>
      <h2 class="fx-panel-title">Configura tu salario</h2>
      <div>
        <label class="fx-label" for="gross">Salario bruto por pago</label>
        <div class="fx-money"><FxIcon name="banknote" size={22} /><span class="fx-prefix" aria-hidden="true">B/.</span><input id="gross" name="gross" type="number" min="0.01" step="0.01" inputmode="decimal" required placeholder="1,500.00" autocomplete="off" aria-describedby="frequency-help" /><FxIcon name="pencil" size={18} /></div>
      </div>
      <div>
        <span class="fx-label" id="frequency-label">Frecuencia de pago</span>
        <fieldset class="fx-segmented frequencies" aria-labelledby="frequency-label" aria-describedby="frequency-help">
          <label><input type="radio" name="frequency" value="monthly" checked />Mensual</label>
          <label><input type="radio" name="frequency" value="fortnightly" />Quincenal</label>
          <label><input type="radio" name="frequency" value="biweekly" />Bisemanal</label>
          <label><input type="radio" name="frequency" value="weekly" />Semanal</label>
        </fieldset>
        <p class="fx-hint" id="frequency-help">Lo que dice tu contrato antes de descuentos. Quincenal = 24 pagos al año; bisemanal = 26 (cada dos semanas).</p>
      </div>
      <details class="fx-details">
        <summary><FxIcon name="sliders" size={18} />Comisiones, deducciones y opciones<span class="fx-chev"><FxIcon name="chevronDown" size={18} /></span></summary>
        <div class="fx-details-body">
          <div>
            <label class="fx-label" for="other">Ingresos variables promedio por pago</label>
            <div class="fx-money" style="min-height:52px"><span class="fx-prefix" aria-hidden="true" style="font-size:1.1rem">B/.</span><input id="other" name="other" type="number" min="0" step="0.01" inputmode="decimal" placeholder="0.00" style="font-size:1.1rem" /></div>
            <p class="fx-hint">Comisiones o sobretiempo habituales. Usa un promedio: la calculadora supone que se repiten en cada pago. No incluyas bonos únicos.</p>
          </div>
          <label class="fx-check"><input type="checkbox" name="joint" /><span><strong>Declaro en forma conjunta con mi cónyuge.</strong> Resta B/.800 al año antes de calcular el ISR (Código Fiscal, art. 709).</span></label>
          <div>
            <label class="fx-label" for="deductions">Otras deducciones anuales declaradas a tu empleador</label>
            <div class="fx-money" style="min-height:52px"><span class="fx-prefix" aria-hidden="true" style="font-size:1.1rem">B/.</span><input id="deductions" name="deductions" type="number" min="0" step="0.01" inputmode="decimal" placeholder="0.00" style="font-size:1.1rem" /></div>
            <p class="fx-hint">Intereses hipotecarios de tu vivienda, intereses de préstamos educativos, seguro de hospitalización o aportes a fondos de pensiones. Solo cuentan si el empleador los comprueba.</p>
          </div>
          <label class="fx-check"><input type="checkbox" name="thirteenth" checked /><span><strong>Incluir el décimo tercer mes en la proyección del ISR.</strong> Es lo habitual en la planilla; desmárcalo si este año no recibirás las tres partidas.</span></label>
        </div>
      </details>
      <p class="fx-error" id="salary-error" role="alert"></p>
      <button class="fx-btn is-block" type="submit"><FxIcon name="calculator" size={20} />Calcular salario neto</button>
      <p class="fx-hint" style="display:flex;gap:8px;align-items:center;margin:0"><FxIcon name="lock" size={16} />El cálculo ocurre en tu dispositivo. No se guarda ni se envía.</p>
    </form>

    <div class="fx-o6">
      <a class="fx-linkrow" href="#como-se-calcula"><FxIcon name="book" size={20} /><span>Metodología y fuentes oficiales</span><FxIcon name="chevronRight" size={18} /></a>
      <h2 class="fx-section-label">Herramientas relacionadas</h2>
      <ul class="fx-related">{related.map(r => <li><a class="fx-linkrow" href={href(r.path)}><FxIcon name={r.icon} size={20} /><span>{r.label}</span><FxIcon name="arrowUpRight" size={18} /></a></li>)}</ul>
    </div>
  </div>

  <article class="fx-prose">
    <h2>Antes de calcular tu salario neto</h2>
    <p>El salario bruto es el importe antes de descuentos; el neto es la estimación de lo que recibes después de las retenciones consideradas. Selecciona la frecuencia de tu pago e introduce el bruto correspondiente a ese mismo período. Si tus ingresos varían, puedes indicar un promedio y revisar las opciones adicionales.</p>
    <p>Para estimar el pago de un descanso, utiliza la <a href={`${import.meta.env.BASE_URL}calculadoras/vacaciones/`}>calculadora de vacaciones</a>. Si terminó tu relación de trabajo, consulta la <a href={`${import.meta.env.BASE_URL}calculadoras/liquidacion-laboral/`}>calculadora de liquidación laboral</a>; sus conceptos y supuestos son distintos.</p>
    <h2 id="como-se-calcula">¿Cómo se calcula el salario neto en Panamá?</h2>
    <p>Del salario bruto se restan tres conceptos. Los dos primeros son porcentajes fijos de cada pago; el tercero depende de lo que ganarás en todo el año.</p>
    <ol>
      <li><strong>Seguro Social (CSS): 9.75%</strong> del salario, incluidas comisiones y sobretiempo (Ley 51 de 2005, texto único de 2025, arts. 85 y 96). La reforma de la Ley 462 de 2025 subió la cuota del empleador, no la del trabajador.</li>
      <li><strong>Seguro Educativo: 1.25%</strong> de los «salarios básicos recibidos» (Ley 13 de 1987).
        <p><strong>En esta estimación:</strong> se aplica al salario del pago y a los ingresos variables que indiques, como comisiones o sobretiempo. La base que use tu empleador puede ser distinta; revisa tu comprobante de pago.</p>
        <p><strong>Décimo tercer mes:</strong> es un pago distinto y no se le descuenta Seguro Educativo.</p>
      </li>
      <li><strong>Impuesto sobre la renta (ISR):</strong> el empleador proyecta tu ingreso del año (12 salarios más el décimo, que también es renta gravable), resta las deducciones que le hayas declarado y aplica la tarifa del artículo 700 del Código Fiscal. El artículo 704 le ordena retener «aplicando proporcionalmente la tarifa», así que el impuesto anual se reparte en proporción a cada pago.</li>
    </ol>
    <p class="formula">ISR anual = tarifa del art. 700 sobre (ingreso proyectado − deducciones): 0 hasta B/.11,000 · 15% del excedente hasta B/.50,000 · B/.5,850 + 25% del excedente de B/.50,000</p>
    <p class="formula">ISR por pago = bruto del pago × ISR anual ÷ ingreso anual proyectado</p>
    <p>Las cuotas de Seguro Social y Seguro Educativo <strong>no</strong> se restan de la base del ISR: no figuran entre las deducciones del artículo 709 y la deducción del Seguro Educativo fue derogada por el Decreto Ejecutivo 98 de 2010.</p>

    <h3>Impuesto anual y retención de cada pago</h3>
    <p>El ISR es anual y la retención es un anticipo. Con un salario fijo todo el año, la suma de las retenciones coincide con el impuesto anual. Si recibes aumentos, comisiones que cambian cada mes o trabajas solo parte del año, el empleador recalcula la retención y, al terminar el año o la relación laboral, compara lo retenido con el impuesto causado: devuelve el exceso como crédito o retiene la diferencia (Decreto Ejecutivo 170 de 1993). Por eso, con ingresos variables, esta calculadora da una <strong>estimación orientativa</strong> basada en tu promedio.</p>

    <h3>Ejemplo con B/.1,500 mensuales</h3>
    <p>Ingreso anual proyectado: 1,500 × 13 = B/.19,500. Excedente sobre B/.11,000: B/.8,500. ISR anual: 15% de 8,500 = B/.1,275, que equivale a B/.98.08 por cada pago de B/.1,500. Con B/.146.25 de Seguro Social y B/.18.75 de Seguro Educativo, el neto queda en <strong>B/.1,236.92</strong>.</p>

    <h2>Tabla de salario neto mensual en Panamá</h2>
    <p>Estimaciones para un salario mensual fijo, con el décimo incluido en la proyección del ISR y sin deducciones personales.</p>
    <div class="table-wrap">
      <table>
        <caption>Calculado con los parámetros vigentes revisados en esta página.</caption>
        <thead><tr><th scope="col">Bruto</th><th scope="col">CSS</th><th scope="col">S. Educ.</th><th scope="col">ISR</th><th scope="col">Neto</th></tr></thead>
        <tbody>
          {examples.map(row => (
            <tr><th scope="row">{formatMoney(row.gross)}</th><td>{formatMoney(row.socialSecurity)}</td><td>{formatMoney(row.educationalInsurance)}</td><td>{formatMoney(row.incomeTax)}</td><td><strong>{formatMoney(row.net)}</strong></td></tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2>Lo que esta calculadora no incluye</h2>
    <ul>
      <li>Bonificaciones únicas o pagos ocasionales: cambian la proyección anual de un modo que depende del procedimiento del empleador.</li>
      <li>Ingresos de otros empleadores, gastos de representación, que tienen su propia retención, ni ajustes de la declaración anual.</li>
      <li>Redondeos de la tabla de retención de la DGI, que pueden variar unos centavos.</li>
      <li>Descuentos voluntarios o judiciales: préstamos, cuotas sindicales, pensiones alimenticias o embargos.</li>
      <li>Topes, exenciones o tratamientos especiales de casos particulares.</li>
    </ul>

    <Faq items={faq} />
    <LegalSources sources={['css', 'educationalInsurance', 'incomeTax', 'incomeTaxRegulation']} />
  </article>
</div>
</Layout>

<script>
  import { calculateNetSalary, type Frequency } from '../../lib/calculations';
  import { formatMoney, formatPercent } from '../../lib/format';
  import { $, bindCalculator, bindShare, readNumber, readText, setOutputs } from '../../lib/ui';
  import { buildShareText } from '../../lib/share';
  import { fxCopy, fxPulse } from '../../lib/fx-icons';

  const labels: Record<Frequency, string> = { monthly: 'por mes', fortnightly: 'por quincena', biweekly: 'cada dos semanas', weekly: 'por semana' };
  const result = $('#salary-result');
  let shareData: import('../../lib/share').ShareData = { tool: 'salary' };

  bindCalculator({
    form: $<HTMLFormElement>('#salary-form'),
    error: $('#salary-error'),
    empty: $('#salary-empty'),
    result,
    run(data) {
      const gross = readNumber(data, 'gross');
      const other = readNumber(data, 'other') ?? 0;
      const deductions = readNumber(data, 'deductions') ?? 0;
      if (gross === undefined || !(gross > 0)) return 'Escribe un salario bruto mayor que cero.';
      if (!(other >= 0)) return 'Los ingresos variables no pueden ser negativos.';
      if (!(deductions >= 0)) return 'Las deducciones no pueden ser negativas.';
      const frequency = readText(data, 'frequency') as Frequency;
      const out = calculateNetSalary({
        grossPerPay: gross, frequency, otherPerPay: other,
        includeThirteenth: data.get('thirteenth') === 'on',
        jointFiling: data.get('joint') === 'on',
        otherAnnualDeductions: deductions
      });
      setOutputs(result, {
        frequencyLabel: labels[frequency],
        net: formatMoney(out.net),
        totalDeductions: formatMoney(out.totalDeductions),
        deductionRate: formatPercent(out.totalDeductions / out.gross),
        gross: formatMoney(out.gross),
        socialSecurity: formatMoney(out.socialSecurity),
        educationalInsurance: formatMoney(out.educationalInsurance),
        incomeTax: formatMoney(out.incomeTax),
        isrNote: out.incomeTax > 0 ? `${formatPercent(out.effectiveTaxRate)} efectivo` : 'renta gravable anual de hasta B/.11,000',
        netMonthlyEquivalent: formatMoney(out.netMonthlyEquivalent),
        projectedAnnualIncome: formatMoney(out.projectedAnnualIncome),
        annualIncomeTax: formatMoney(out.annualIncomeTax),
        marginalTaxRate: formatPercent(out.marginalTaxRate),
        taxableAnnual: formatMoney(out.taxableAnnual),
        annualDeductions: formatMoney(out.annualDeductions)
      });
      renderDistribution(out);
      shareData = { tool: 'salary', primary: `Salario neto estimado: ${formatMoney(out.net)} ${labels[frequency]}`, details: [`Seguro Social: ${formatMoney(out.socialSecurity)}`, `Seguro Educativo: ${formatMoney(out.educationalInsurance)}`, `ISR estimado: ${formatMoney(out.incomeTax)}`] };
    }
  });
  bindShare($<HTMLButtonElement>('#salary-share'), () => shareData);

  // Presentación Midnight Functional: anillo de disponible, barra de distribución y animación discreta.
  function renderDistribution(out: ReturnType<typeof calculateNetSalary>) {
    const available = out.gross > 0 ? out.net / out.gross : 0;
    const donut = $('#salary-donut');
    donut.style.setProperty('--fx-value', String(Math.round(available * 1000) / 10));
    $('[data-donut-value]', donut).textContent = formatPercent(available);
    donut.setAttribute('aria-label', `Disponible: ${formatPercent(available)} del salario bruto`);
    const parts = [
      { label: 'Neto', value: out.net, tone: 1 },
      { label: 'Seguro Social', value: out.socialSecurity, tone: 2 },
      { label: 'Seguro Educativo', value: out.educationalInsurance, tone: 4 },
      { label: 'ISR', value: out.incomeTax, tone: 3 }
    ];
    const split = $('#salary-split'), legend = $('#salary-legend');
    split.replaceChildren(); legend.replaceChildren();
    for (const part of parts) {
      if (part.value <= 0) continue;
      const bar = document.createElement('span'); bar.className = `fx-tone-${part.tone}`; bar.style.flex = String(part.value); split.append(bar);
      const item = document.createElement('li'), dot = document.createElement('i'); dot.className = `fx-tone-${part.tone}`;
      item.append(dot, `${part.label} ${formatPercent(part.value / out.gross)}`); legend.append(item);
    }
    split.setAttribute('aria-label', parts.map(p => `${p.label}: ${formatMoney(p.value)}`).join('; '));
    fxPulse($('#salary-hero'));
  }

  const status = $('#salary-action-status');
  $<HTMLButtonElement>('#salary-copy').addEventListener('click', async () => {
    const text = buildShareText(shareData, { includePrimary: true, includeDetails: true, selectedProducts: [] });
    status.textContent = await fxCopy(text) ? 'Resultado copiado.' : 'No se pudo copiar. Usa Compartir para ver el texto.';
  });
  $<HTMLButtonElement>('#salary-reset').addEventListener('click', () => {
    $<HTMLFormElement>('#salary-form').reset();
    result.hidden = true;
    $('#salary-empty').hidden = false;
    $('#salary-error').textContent = '';
    shareData = { tool: 'salary' };
    status.textContent = 'Cálculo reiniciado.';
    $<HTMLInputElement>('#gross').focus();
  });
</script>
