---
import Layout from '../../layouts/Layout.astro';
import AdSlot from '../../components/AdSlot.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import Icon from '../../components/Icon.astro';
import LegalSources from '../../components/LegalSources.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const path = '/calculadoras/decimo-tercer-mes/';
const base = import.meta.env.BASE_URL;
const faq = [
  { q: '¿Cuánto es el décimo tercer mes en Panamá?', a: 'En la práctica de planillas, cada partida equivale a la doceava parte de lo devengado en los cuatro meses que cubre. Con un salario fijo todo el período, la partida bruta es un tercio del salario mensual: con B/.900 al mes, B/.300. El decreto que lo creó lo expresa como un día de salario por cada once días de trabajo efectivo.' },
  { q: '¿Cuándo se paga el décimo tercer mes?', a: 'El 15 de abril, el 15 de agosto y el 15 de diciembre (Decreto de Gabinete 221 de 1971, art. 3). La norma fija las fechas de pago, no los cortes de cada período; lo habitual es cortar el día 15 (16 dic–15 abr, 16 abr–15 ago, 16 ago–15 dic), aunque algunos empleadores usan cortes de fin de mes.' },
  { q: '¿Qué descuentos tiene el décimo?', a: 'El trabajador aporta una contribución especial de 7.25% a la Caja de Seguro Social sobre cada partida (Ley 51 de 2005, texto único de 2025, art. 96). No se descuenta Seguro Educativo. El décimo es renta gravable, por lo que puede llevar retención de impuesto sobre la renta si tu ingreso anual supera B/.11,000.' },
  { q: '¿Me corresponde décimo si entré a mitad del período?', a: 'Sí, en proporción a lo que devengaste desde tu ingreso. En el modo «Salario fijo», indica tu fecha de ingreso y la calculadora prorratea los días trabajados del período.' },
  { q: '¿Se incluyen comisiones y horas extra?', a: 'Sí. El Decreto 19 de 1973 (art. 4) manda calcular cada partida sobre los salarios del período incluyendo salario base, horas extra, recargos, comisiones, primas, vacaciones, licencias pagadas y bonificaciones.' },
  { q: 'Si renuncio o me despiden, ¿pierdo el décimo?', a: 'No. La parte proporcional del período en curso se paga con la liquidación. Puedes estimarla en la calculadora de liquidación laboral.' }
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Calculadora del décimo tercer mes Panamá',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  inLanguage: 'es-PA',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }
};
---
<Layout title="Calculadora del décimo tercer mes Panamá 2026: abril, agosto y diciembre" description="Calcula tu décimo tercer mes en Panamá: partidas de abril, agosto y diciembre, período exacto, descuento de 7.25% de CSS, ISR estimado y cálculo proporcional si entraste a mitad del período." canonicalPath={path} schema={schema}>
  <header class="page-head container">
    <Breadcrumbs items={[{ label: 'Décimo tercer mes', path }]} />
    <span class="eyebrow">Prestación laboral</span>
    <h1>Calculadora del décimo tercer mes</h1>
    <p>Calcula la partida de abril, agosto o diciembre con tu salario fijo o con lo que realmente devengaste en el período.</p>
  </header>

  <div class="container calculator-shell">
    <form class="panel" id="thirteenth-form" novalidate>
      <h2>Datos de la partida</h2>
      <div class="form-grid">
        <div class="field">
          <label for="period">Partida</label>
          <select id="period" name="period">
            <option value="abril">15 de abril (16 dic – 15 abr)</option>
            <option value="agosto">15 de agosto (16 abr – 15 ago)</option>
            <option value="diciembre">15 de diciembre (16 ago – 15 dic)</option>
          </select>
        </div>
        <div class="field">
          <label for="year">Año de pago</label>
          <input id="year" name="year" type="number" inputmode="numeric" min="2000" max="2100" step="1" required />
        </div>
        <div class="field full">
          <span class="field-label" id="mode-label">¿Cómo quieres calcular?</span>
          <fieldset class="segmented" aria-labelledby="mode-label">
            <label><input type="radio" name="mode" value="salary" checked />Con mi salario fijo</label>
            <label><input type="radio" name="mode" value="earnings" />Con lo devengado</label>
          </fieldset>
        </div>

        <div class="field full" data-mode="salary">
          <label for="monthly">Salario mensual</label>
          <div class="input-wrap"><span class="prefix">B/.</span><input id="monthly" name="monthly" type="number" min="0.01" step="0.01" inputmode="decimal" placeholder="900.00" /></div>
        </div>
        <div class="field full" data-mode="salary">
          <label for="start">Fecha de ingreso <span class="muted">(solo si entraste durante el período)</span></label>
          <input id="start" name="start" type="date" />
          <small>Si trabajaste el período completo, déjala vacía.</small>
        </div>

        <div class="field" data-mode="earnings" hidden>
          <label for="ordinary">Salarios devengados en el período</label>
          <div class="input-wrap"><span class="prefix">B/.</span><input id="ordinary" name="ordinary" type="number" min="0" step="0.01" inputmode="decimal" placeholder="3,600.00" /></div>
          <small>Salario base cobrado en el período, incluidas vacaciones y licencias pagadas.</small>
        </div>
        <div class="field" data-mode="earnings" hidden>
          <label for="variable">Horas extra, comisiones, primas y bonificaciones</label>
          <div class="input-wrap"><span class="prefix">B/.</span><input id="variable" name="variable" type="number" min="0" step="0.01" inputmode="decimal" placeholder="0.00" /></div>
        </div>
        <div class="field full" data-mode="earnings" hidden>
          <label for="regular">Salario mensual habitual <span class="muted">(opcional, para estimar ISR)</span></label>
          <div class="input-wrap"><span class="prefix">B/.</span><input id="regular" name="regular" type="number" min="0" step="0.01" inputmode="decimal" placeholder="900.00" /></div>
        </div>
      </div>
      <p class="form-error" id="thirteenth-error" role="alert"></p>
      <button class="calculate" type="submit">Calcular décimo</button>
    </form>

    <section class="panel results" id="thirteenth-results" aria-live="polite" aria-label="Resultado">
      <div id="thirteenth-empty" class="empty-state"><Icon name="thirteenth" size={40} /><p>Elige la partida, escribe tu salario y pulsa <strong>Calcular</strong>.</p></div>
      <div id="thirteenth-result" hidden>
        <div class="result-hero">
          <div class="label"><span data-out="netLabel"></span> · <span data-out="periodLabel"></span></div>
          <div class="amount" data-out="net"></div>
          <div class="sub">Se paga el <strong data-out="payDate"></strong></div>
        </div>
        <div id="thirteenth-bar"></div>
        <ul class="breakdown">
          <li><span>Base del período <small data-out="baseNote"></small></span><strong data-out="periodEarnings"></strong></li>
          <li><span>Décimo bruto <small>base ÷ 12</small></span><strong data-out="gross"></strong></li>
          <li class="minus"><span>Seguro Social <small>7.25% (contribución especial)</small></span><strong data-out="socialSecurity"></strong></li>
          <li class="minus" data-row="isr"><span>ISR estimado <small data-out="isrNote"></small></span><strong data-out="incomeTax"></strong></li>
          <li class="muted-row" data-row="noIsr"><span>ISR</span><strong>Indica tu salario habitual</strong></li>
          <li class="total"><span data-out="netLabel"></span><strong data-out="net"></strong></li>
        </ul>
        <p class="callout info" data-row="prorated">Prorrateado: <span data-out="workedDays"></span> de <span data-out="periodDays"></span> días del período, con cortes el día 15.</p>
        <p class="callout info">Resultado orientativo: sigue la práctica de planilla (devengado ÷ 12). Si tu empleador corta los períodos a fin de mes o tuviste variables, usa el modo «Con lo devengado».</p>
        <div class="result-actions">
          <button class="button secondary" type="button" id="thirteenth-share"><Icon name="share" size={18} />Compartir</button>
          <a class="button secondary" href={`${base}guias/fechas-de-pago-del-decimo-tercer-mes/`}>Fechas y reglas</a>
        </div>
      </div>
    </section>
  </div>

  <div class="container"><AdSlot name="afterResult" /></div>

  <article class="container article">
    <h2>¿Cómo se calcula el décimo tercer mes?</h2>
    <p>El décimo tercer mes lo creó el Decreto de Gabinete 221 de 1971 y se paga en tres partidas, el 15 de abril, el 15 de agosto y el 15 de diciembre. Cada una corresponde a lo devengado en los cuatro meses anteriores. La norma fija las fechas de pago; los cortes del día 15 de la tabla son los habituales en planilla:</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th scope="col">Partida</th><th scope="col">Período</th><th scope="col">Pago</th></tr></thead>
        <tbody>
          <tr><th scope="row">Primera</th><td>16 dic – 15 abr</td><td>15 de abril</td></tr>
          <tr><th scope="row">Segunda</th><td>16 abr – 15 ago</td><td>15 de agosto</td></tr>
          <tr><th scope="row">Tercera</th><td>16 ago – 15 dic</td><td>15 de diciembre</td></tr>
        </tbody>
      </table>
    </div>
    <p class="formula">Décimo bruto = salarios y remuneraciones devengados en el período ÷ 12</p>
    <p>Con un salario fijo, el período completo suma cuatro salarios, así que la partida bruta equivale a un tercio del salario mensual. Si entraste a mitad del período, la calculadora estima lo devengado en proporción a los días trabajados.</p>
    <h3>Qué dice exactamente la norma</h3>
    <p>El artículo 2 del Decreto de Gabinete 221 de 1971 expresa el derecho como <em>«un día de salario por cada once días, o fracción de trabajo efectivo»</em>, y cuenta como trabajados los días de enfermedad, maternidad, licencia y vacaciones. El Decreto 19 de 1973 (art. 4) ordena calcular cada partida sobre los salarios del período, incluidos horas extra, comisiones, primas, vacaciones y bonificaciones. Las planillas lo aplican como <strong>lo devengado en el período ÷ 12</strong>, que equivale a un mes de salario al año. Esta calculadora sigue esa práctica; ante una discrepancia concreta, la autoridad competente es MITRADEL.</p>
    <h3>Descuentos</h3>
    <ul>
      <li><strong>Seguro Social: 7.25%</strong> de la partida, como contribución especial del empleado (Ley 51 de 2005, texto único de 2025, art. 96, num. 5).</li>
      <li><strong>Seguro Educativo:</strong> no se aplica al décimo.</li>
      <li><strong>Impuesto sobre la renta:</strong> el décimo es renta gravable. La calculadora estima la parte proporcional con tu salario habitual: el ISR anual de 13 pagos repartido en partes iguales. El empleador puede retener un monto distinto según su tabla y tus deducciones.</li>
    </ul>
    <h3>Ejemplo</h3>
    <p>Con B/.900 mensuales todo el período de agosto: base 4 × 900 = B/.3,600; décimo bruto B/.300; Seguro Social 7.25% = B/.21.75. Como 900 × 13 = B/.11,700 supera ligeramente B/.11,000, el ISR proporcional estimado es de unos B/.2.69, y el neto queda cerca de <strong>B/.275.56</strong>.</p>
    <Faq items={faq} />
    <LegalSources sources={['thirteenth', 'thirteenthRegulation', 'css', 'incomeTax', 'mitradel']} />
  </article>

  <div class="container"><RelatedCalculators current={path} /></div>
</Layout>

<script>
  import { calculateThirteenthMonth, estimatePeriodEarnings, thirteenthPeriod, thirteenthPeriodContaining, type ThirteenthPeriodId } from '../../lib/calculations';
  import { formatDate, formatMoney, formatPercent } from '../../lib/format';
  import { $, bindCalculator, bindShare, readNumber, readText, renderBar, setOutputs, toggleRows } from '../../lib/ui';

  const form = $<HTMLFormElement>('#thirteenth-form');
  const result = $('#thirteenth-result');
  let summary = '';

  // Propone la próxima partida según la fecha de hoy.
  const today = new Date();
  const todayIso = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;
  const upcoming = thirteenthPeriodContaining(todayIso);
  $<HTMLSelectElement>('#period').value = upcoming.id;
  $<HTMLInputElement>('#year').value = String(upcoming.year);

  const syncMode = () => {
    const mode = readText(new FormData(form), 'mode');
    form.querySelectorAll<HTMLElement>('[data-mode]').forEach(el => { el.hidden = el.dataset.mode !== mode; });
  };
  form.addEventListener('change', event => { if ((event.target as HTMLInputElement).name === 'mode') syncMode(); });
  syncMode();

  bindCalculator({
    form,
    error: $('#thirteenth-error'),
    empty: $('#thirteenth-empty'),
    result,
    run(data) {
      const year = readNumber(data, 'year');
      if (year === undefined || !Number.isInteger(year) || year < 2000 || year > 2100) return 'Escribe un año de pago válido.';
      const period = thirteenthPeriod(readText(data, 'period') as ThirteenthPeriodId, year);
      const mode = readText(data, 'mode');
      let ordinary: number, variable = 0, regular: number | undefined, prorated: { workedDays: number; periodDays: number } | null = null;

      if (mode === 'salary') {
        const monthly = readNumber(data, 'monthly');
        if (monthly === undefined || !(monthly > 0)) return 'Escribe tu salario mensual.';
        const start = readText(data, 'start') || undefined;
        if (start && start > period.end) return 'Tu fecha de ingreso es posterior al período elegido: esa partida no te corresponde.';
        const estimate = estimatePeriodEarnings(monthly, period, start);
        ordinary = estimate.earnings;
        regular = monthly;
        if (estimate.workedDays < estimate.periodDays) prorated = estimate;
      } else {
        const o = readNumber(data, 'ordinary') ?? 0;
        const v = readNumber(data, 'variable') ?? 0;
        if (!(o >= 0) || !(v >= 0) || o + v <= 0) return 'Escribe lo devengado en el período (mayor que cero).';
        ordinary = o; variable = v;
        const r = readNumber(data, 'regular');
        if (r !== undefined && !(r >= 0)) return 'El salario habitual no es válido.';
        regular = r && r > 0 ? r : undefined;
      }

      const out = calculateThirteenthMonth({ ordinaryEarnings: ordinary, variableEarnings: variable, regularMonthlySalary: regular });
      setOutputs(result, {
        netLabel: out.incomeTax === null ? 'Neto antes de ISR' : 'Neto estimado',
        periodLabel: `${period.label} ${period.year}`,
        payDate: formatDate(period.payDate),
        net: formatMoney(out.net),
        baseNote: `${formatDate(period.start)} – ${formatDate(period.end)}`,
        periodEarnings: formatMoney(out.periodEarnings),
        gross: formatMoney(out.gross),
        socialSecurity: formatMoney(out.socialSecurity),
        incomeTax: formatMoney(out.incomeTax ?? 0),
        isrNote: out.incomeTaxRate ? `${formatPercent(out.incomeTaxRate)} proporcional` : 'no aplica bajo B/.11,000 al año',
        workedDays: String(prorated?.workedDays ?? ''),
        periodDays: String(prorated?.periodDays ?? '')
      });
      toggleRows(result, { isr: out.incomeTax !== null, noIsr: out.incomeTax === null, prorated: prorated !== null });
      renderBar($('#thirteenth-bar'), [
        { label: out.incomeTax === null ? 'Neto antes de ISR' : 'Neto estimado', value: out.net, tone: 'net' },
        { label: 'Seguro Social', value: out.socialSecurity, tone: 'css' },
        { label: 'ISR', value: out.incomeTax ?? 0, tone: 'isr' }
      ], formatMoney);
      summary = `Décimo tercer mes (${period.label.toLowerCase()} ${period.year}, pago ${formatDate(period.payDate)}): bruto ${formatMoney(out.gross)}, ${out.incomeTax === null ? 'neto antes de ISR' : 'neto estimado'} ${formatMoney(out.net)}. Calculado en Calcula Panamá.`;
    }
  });
  bindShare($<HTMLButtonElement>('#thirteenth-share'), () => summary);
</script>
