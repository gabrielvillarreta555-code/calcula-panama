---
import Layout from '../../layouts/Layout.astro';
import AdSlot from '../../components/AdSlot.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BlueHelp from '../../components/BlueHelp.astro';
import Faq from '../../components/Faq.astro';
import Icon from '../../components/Icon.astro';
import LegalSources from '../../components/LegalSources.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';

const path = '/calculadoras/liquidacion-laboral/';
const base = import.meta.env.BASE_URL;
const faq = [
  { q: '¿Qué incluye una liquidación laboral en Panamá?', a: 'Siempre: las vacaciones pendientes y el décimo tercer mes proporcional. En contratos por tiempo indefinido, además, la prima de antigüedad, sea cual sea el motivo de la terminación. La indemnización solo corresponde en despido injustificado, renuncia con causa justificada, causa económica o terminación anticipada de un contrato definido sin justa causa.' },
  { q: 'Si renuncio, ¿me pagan prima de antigüedad?', a: 'Sí, si tu contrato es por tiempo indefinido. El artículo 224 la reconoce a la terminación de todo contrato indefinido, cualquiera que sea la causa: una semana de salario por cada año trabajado, proporcional por fracción.' },
  { q: '¿Cuánto es la indemnización por despido injustificado?', a: 'Para relaciones que empezaron después de la Ley 44 de 1995: 3.4 semanas de salario por cada año en los primeros diez años y una semana por cada año posterior, con parte proporcional por fracción (art. 225, acápite C). Se calcula con el salario promedio de los últimos seis meses o de los últimos 30 días, el que sea más favorable (art. 149).' },
  { q: '¿Y si mi contrato era por tiempo definido?', a: 'Si el empleador lo termina antes del vencimiento sin justa causa, debe pagar los salarios que habrías recibido durante el tiempo restante del contrato (art. 227). Indica la fecha pactada de vencimiento para estimarlo.' },
  { q: '¿Por qué el resultado es orientativo?', a: 'El monto final puede cambiar por salarios variables, preaviso, recargos, fueros (maternidad, sindical, riesgo profesional), acuerdos o lo que resuelva una autoridad. Para un caso concreto, acude a MITRADEL.' }
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Calculadora de liquidación laboral Panamá',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  inLanguage: 'es-PA',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }
};
---
<Layout title="Calculadora de liquidación laboral Panamá: prima, indemnización y vacaciones" description="Estima tu liquidación en Panamá: vacaciones, décimo proporcional, prima de antigüedad e indemnización según tu contrato y el motivo (renuncia, despido injustificado, mutuo acuerdo o causa económica)." canonicalPath={path} schema={schema}>
  <header class="page-head container">
    <Breadcrumbs items={[{ label: 'Liquidación laboral', path }]} />
    <span class="eyebrow">Terminación laboral</span>
    <h1>Calculadora de liquidación laboral</h1>
    <p>Separa cada concepto según tu contrato y el motivo de terminación. No todos los trabajadores reciben lo mismo, y aquí verás por qué.</p>
  </header>

  <div class="container calculator-shell">
    <form class="panel" id="termination-form" novalidate>
      <h2>La relación laboral</h2>
      <BlueHelp guidance="Reúne tu salario mensual, las fechas, el tipo de contrato y el motivo de terminación. Algunos conceptos necesitan revisión adicional." steps={["Escribe tu salario mensual y las fechas de ingreso y último día trabajado.", "Elige el tipo de contrato y el motivo de terminación.", "Si conoces los días pendientes, lo devengado o el promedio de cinco años, puedes indicarlos en las opciones."]} />
      <div class="form-grid">
        <div class="field full">
          <label for="salary">Salario mensual</label>
          <div class="input-wrap"><span class="prefix">B/.</span><input id="salary" name="salary" type="number" min="0.01" step="0.01" inputmode="decimal" required placeholder="1,000.00" /></div>
          <small>Si cobras comisiones o sobretiempo, usa el promedio de los últimos 6 meses o el de los últimos 30 días, el que sea mayor (art. 149).</small>
        </div>
        <div class="field">
          <label for="start">Fecha de ingreso</label>
          <input id="start" name="start" type="date" required />
        </div>
        <div class="field">
          <label for="end">Último día de trabajo</label>
          <input id="end" name="end" type="date" required />
        </div>
        <div class="field">
          <label for="contract">Tipo de contrato</label>
          <select id="contract" name="contract">
            <option value="indefinite">Por tiempo indefinido</option>
            <option value="fixed">Por tiempo definido</option>
            <option value="specific-work">Por obra determinada</option>
          </select>
        </div>
        <div class="field">
          <label for="reason">Motivo de terminación</label>
          <select id="reason" name="reason">
            <option value="resignation">Renuncia voluntaria</option>
            <option value="mutual">Mutuo acuerdo</option>
            <option value="unjustified">Despido injustificado</option>
            <option value="justified">Despido con causa justificada</option>
            <option value="justified-resignation">Renuncia con causa justificada (art. 223)</option>
            <option value="economic">Causa económica (art. 213 C)</option>
            <option value="expiry">Vencimiento del contrato o fin de la obra</option>
          </select>
        </div>
        <div class="field full" data-show="notice" hidden>
          <label for="notice">¿Te avisaron por escrito con 30 días de anticipación?</label>
          <select id="notice" name="notice">
            <option value="">No lo sé</option>
            <option value="yes">Sí, recibí el aviso</option>
            <option value="no">No, me despidieron sin aviso</option>
          </select>
          <small>Con menos de dos años de servicio, el despido sin causa obliga a pagar indemnización y preaviso de 30 días (art. 212).</small>
        </div>
        <div class="field full" data-show="agreed" hidden>
          <label for="agreed">Fecha pactada de vencimiento o conclusión</label>
          <input id="agreed" name="agreed" type="date" />
          <small>Para calcular los salarios del tiempo restante (art. 227).</small>
        </div>
        <details class="more field full">
          <summary>Ajustar vacaciones, décimo y prima</summary>
          <div class="form-grid">
            <div class="field">
              <label for="vacationDays">Días de vacaciones pendientes</label>
              <input id="vacationDays" name="vacationDays" type="number" min="0" step="0.5" inputmode="decimal" placeholder="Estimar" />
              <small>Vacío: se estiman solo las del año de servicio en curso.</small>
            </div>
            <div class="field">
              <label for="periodEarnings">Devengado desde el último décimo</label>
              <div class="input-wrap"><span class="prefix">B/.</span><input id="periodEarnings" name="periodEarnings" type="number" min="0" step="0.01" inputmode="decimal" placeholder="Estimar" /></div>
              <small>Vacío: se estima con tu salario desde el día 16 del último mes de pago.</small>
            </div>
            <div class="field full">
              <label for="average5">Promedio mensual de los últimos 5 años</label>
              <div class="input-wrap"><span class="prefix">B/.</span><input id="average5" name="average5" type="number" min="0" step="0.01" inputmode="decimal" placeholder="Igual al salario" /></div>
              <small>La prima de antigüedad se calcula con este promedio (art. 226).</small>
            </div>
          </div>
        </details>
      </div>
      <p class="form-error" id="termination-error" role="alert"></p>
      <button class="calculate" type="submit">Calcular liquidación</button>
    </form>

    <section class="panel results" aria-live="polite" aria-label="Resultado">
      <div id="termination-empty" class="empty-state"><Icon name="termination" size={40} /><p>Completa salario, fechas, contrato y motivo para ver qué conceptos te corresponden.</p></div>
      <div id="termination-result" hidden>
        <div class="result-hero">
          <div class="label" data-out="grossLabel"></div>
          <div class="amount" data-out="total"></div>
          <div class="sub"><span data-out="tenure"></span> de servicio</div>
        </div>
        <div id="termination-bar"></div>
        <ul class="breakdown">
          <li><span>Vacaciones <small data-out="vacationNote"></small></span><strong data-out="vacation"></strong></li>
          <li><span>Décimo tercer mes proporcional <small data-out="thirteenthNote"></small></span><strong data-out="thirteenth"></strong></li>
          <li><span>Prima de antigüedad <small data-out="primaNote"></small></span><strong data-out="seniorityPremium"></strong></li>
          <li><span>Indemnización <small data-out="indemnityNote"></small></span><strong data-out="indemnity"></strong></li>
          <li data-row="preaviso"><span>Preaviso <small>30 días, art. 212</small></span><strong data-out="preaviso"></strong></li>
          <li class="total"><span data-out="grossTotalLabel"></span><strong data-out="total"></strong></li>
        </ul>
        <h3 class="breakdown-title">Descuentos estimados</h3>
        <ul class="breakdown">
          <li class="minus"><span>Seguro Social sobre vacaciones <small>9.75%</small></span><strong data-out="vacationSocialSecurity"></strong></li>
          <li class="minus"><span>Seguro Educativo sobre vacaciones <small>1.25%</small></span><strong data-out="vacationEducationalInsurance"></strong></li>
          <li class="minus"><span>Seguro Social sobre el décimo <small>7.25%</small></span><strong data-out="thirteenthSocialSecurity"></strong></li>
          <li class="minus"><span>ISR sobre prima, indemnización y preaviso <small data-out="terminationTaxNote"></small></span><strong data-out="terminationIncomeTax"></strong></li>
          <li class="total"><span data-out="netLabel"></span><strong data-out="netEstimate"></strong></li>
        </ul>
        <div class="notes" id="termination-notes"></div>
        <p class="callout info">Resultado orientativo. El neto no incluye el ISR ordinario sobre vacaciones y décimo, que depende de tu ingreso anual, ni salarios adeudados, recargos, horas extra pendientes o préstamos. La prima, la indemnización y el preaviso no pagan cuotas de la CSS (Ley 51, art. 86).</p>
        <div class="result-actions">
          <button class="button secondary" type="button" id="termination-share"><Icon name="share" size={18} />Compartir</button>
          <a class="button secondary" href={`${base}guias/prima-de-antiguedad-e-indemnizacion/`}>Entender la prima</a>
        </div>
      </div>
    </section>
  </div>

  <div class="container"><AdSlot name="afterResult" /></div>

  <article class="container article">
    <h2>¿Qué te corresponde según el motivo?</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th scope="col">Motivo (contrato indefinido)</th><th scope="col">Vacac. y décimo</th><th scope="col">Prima</th><th scope="col">Indemn.</th></tr></thead>
        <tbody>
          <tr><th scope="row">Renuncia voluntaria</th><td>Sí</td><td>Sí</td><td>No</td></tr>
          <tr><th scope="row">Mutuo acuerdo</th><td>Sí</td><td>Sí</td><td>No*</td></tr>
          <tr><th scope="row">Despido justificado</th><td>Sí</td><td>Sí</td><td>No</td></tr>
          <tr><th scope="row">Despido injustificado</th><td>Sí</td><td>Sí</td><td>Sí**</td></tr>
          <tr><th scope="row">Renuncia justificada (art. 223)</th><td>Sí</td><td>Sí</td><td>Sí</td></tr>
          <tr><th scope="row">Causa económica (art. 213 C)</th><td>Sí</td><td>Sí</td><td>Sí</td></tr>
        </tbody>
        <caption>* Salvo que el acuerdo incluya una suma adicional. ** Con menos de dos años de servicio, más 30 días de preaviso si no hubo aviso (art. 212); en período probatorio escrito no hay indemnización (art. 78). En contratos definidos o por obra no hay prima de antigüedad; la terminación anticipada sin justa causa obliga a pagar el tiempo restante (art. 227).</caption>
      </table>
    </div>

    <h2>Cómo calculamos cada concepto</h2>
    <h3>Vacaciones (art. 54)</h3>
    <p>Un día por cada 11 trabajados, valorado a salario mensual ÷ 30. Si no indicas los días pendientes, estimamos solo los del año de servicio en curso (máximo 30), suponiendo que ya disfrutaste los anteriores.</p>
    <h3>Décimo tercer mes proporcional</h3>
    <p>Lo devengado desde el inicio de la partida en curso (16 de diciembre, 16 de abril o 16 de agosto) dividido entre 12.</p>
    <h3>Prima de antigüedad (arts. 224 y 226)</h3>
    <p class="formula">Prima = (salario promedio de los últimos 5 años × 12 ÷ 52) × años trabajados</p>
    <h3>Indemnización (arts. 225 y 149)</h3>
    <p class="formula">Indemnización = salario semanal × (3.4 × años hasta 10 + 1 × años después de 10)</p>
    <p>Usa el salario de los últimos seis meses o de los últimos 30 días, el más favorable. Si la relación empezó antes de la Ley 44 de 1995, se aplican escalas anteriores combinadas que esta herramienta no automatiza.</p>
    <h3>Años de servicio</h3>
    <p>Contamos los años completos por aniversarios y la fracción del año en curso, con el primer y el último día incluidos. Así, del 1 de enero de 2021 al 31 de diciembre de 2025 son exactamente 5 años, aunque haya un 29 de febrero en medio.</p>
    <h3>Preaviso (art. 212)</h3>
    <p>Con menos de dos años de servicio continuo (y en otros casos del art. 212, como trabajadores domésticos o de empresas muy pequeñas), el empleador puede despedir sin causa justificada, pero debe pagar la indemnización y avisar con 30 días de anticipación o pagar ese preaviso. Si estabas en período probatorio pactado por escrito (hasta 3 meses, art. 78), no hay indemnización ni preaviso.</p>
    <h3>Descuentos</h3>
    <ul>
      <li><strong>Vacaciones:</strong> son salario; llevan 9.75% de CSS, 1.25% de Seguro Educativo e ISR ordinario.</li>
      <li><strong>Décimo proporcional:</strong> 7.25% de CSS e ISR ordinario.</li>
      <li><strong>Prima, indemnización y preaviso:</strong> no pagan CSS (Ley 51, art. 86). Para el ISR no se suman al salario: se resta un 1% por cada año completo de servicio y B/.5,000, y al saldo se aplica la tarifa (Decreto Ejecutivo 170 de 1993, art. 119). En la mayoría de las liquidaciones el resultado es cero.</li>
    </ul>
    <h3>Ejemplo</h3>
    <p>Contrato indefinido, B/.1,000 mensuales, del 1 de enero de 2021 al 31 de diciembre de 2025 (5 años exactos), despido injustificado: salario semanal B/.230.77; prima 230.77 × 5 = B/.1,153.85; indemnización 230.77 × 5 × 3.4 = <strong>B/.3,923.08</strong>. A eso se suman las vacaciones y el décimo pendientes. No hay ISR sobre la prima y la indemnización: 5,076.93 − 5% − 5,000 es menor que cero.</p>
    <Faq items={faq} />
    <LegalSources sources={['laborCode', 'css', 'incomeTaxRegulation', 'thirteenth', 'mitradel']} />
  </article>

  <div class="container"><RelatedCalculators current={path} /></div>
</Layout>

<script>
  import { calculateTermination, type ContractType, type TerminationReason } from '../../lib/calculations';
  import { formatMoney, formatNumber } from '../../lib/format';
  import { $, bindCalculator, bindShare, readNumber, readText, renderBar, setOutputs, toggleRows } from '../../lib/ui';

  const form = $<HTMLFormElement>('#termination-form');
  const result = $('#termination-result');
  const agreedField = $('[data-show="agreed"]', form);
  const noticeField = $('[data-show="notice"]', form);
  let summary = '';

  const syncAgreed = () => {
    const data = new FormData(form);
    const unjustified = readText(data, 'reason') === 'unjustified';
    agreedField.hidden = !(readText(data, 'contract') !== 'indefinite' && unjustified);
    noticeField.hidden = !(readText(data, 'contract') === 'indefinite' && unjustified);
  };
  form.addEventListener('change', syncAgreed);
  syncAgreed();

  const tenureText = (fullYears: number, years: number, days: number) => {
    const months = Math.floor((years - fullYears) * 12 + 1e-9);
    const parts = [];
    if (fullYears) parts.push(`${fullYears} ${fullYears === 1 ? 'año' : 'años'}`);
    if (months) parts.push(`${months} ${months === 1 ? 'mes' : 'meses'}`);
    return parts.length ? parts.join(' y ') : `${days} ${days === 1 ? 'día' : 'días'}`;
  };

  bindCalculator({
    form,
    error: $('#termination-error'),
    empty: $('#termination-empty'),
    result,
    run(data) {
      const salary = readNumber(data, 'salary');
      if (salary === undefined || !(salary > 0)) return 'Escribe tu salario mensual.';
      const start = readText(data, 'start');
      const end = readText(data, 'end');
      if (!start || !end) return 'Indica la fecha de ingreso y el último día de trabajo.';
      if (end < start) return 'El último día de trabajo debe ser posterior a la fecha de ingreso.';
      const vacationDays = readNumber(data, 'vacationDays');
      const periodEarnings = readNumber(data, 'periodEarnings');
      const average5 = readNumber(data, 'average5');
      if ([vacationDays, periodEarnings, average5].some(v => v !== undefined && !(v >= 0))) return 'Revisa los valores opcionales: no pueden ser negativos.';
      const contractType = readText(data, 'contract') as ContractType;
      const reason = readText(data, 'reason') as TerminationReason;
      const agreed = readText(data, 'agreed') || undefined;
      const notice = readText(data, 'notice');

      const out = calculateTermination({
        monthlySalary: salary, startDate: start, endDate: end, contractType, reason,
        unusedVacationDays: vacationDays, currentPeriodEarnings: periodEarnings,
        averageSalaryLastFiveYears: average5, agreedEndDate: agreed,
        noticeGiven: notice === '' ? undefined : notice === 'yes'
      });

      const indemnityNote = {
        'not-applicable': 'no corresponde por este motivo',
        calculated: contractType === 'indefinite' ? 'art. 225' : 'art. 227, tiempo restante',
        'needs-review': 'requiere revisión'
      }[out.indemnityStatus];
      setOutputs(result, {
        grossLabel: out.indemnityStatus === 'needs-review' ? 'Liquidación bruta parcial' : 'Liquidación bruta estimada',
        grossTotalLabel: out.indemnityStatus === 'needs-review' ? 'Total bruto parcial' : 'Total bruto',
        netLabel: out.indemnityStatus === 'needs-review' ? 'Neto parcial estimado' : 'Neto estimado',
        total: formatMoney(out.total),
        tenure: tenureText(out.fullYears, out.years, out.days),
        vacation: formatMoney(out.vacation),
        vacationNote: `${formatNumber(out.vacationDays)} días${out.vacationEstimated ? ' · estimado' : ''}`,
        thirteenth: formatMoney(out.thirteenth),
        thirteenthNote: out.thirteenthEstimated ? 'estimado con tu salario' : 'devengado ÷ 12',
        seniorityPremium: formatMoney(out.seniorityPremium),
        primaNote: contractType === 'indefinite' ? `${formatNumber(out.years)} ${out.years === 1 ? 'año' : 'años'} × 1 semana` : 'solo contratos indefinidos',
        indemnity: out.indemnityStatus === 'needs-review' ? 'Revisar' : formatMoney(out.indemnity),
        indemnityNote,
        preaviso: formatMoney(out.preaviso),
        vacationSocialSecurity: formatMoney(out.deductions.vacationSocialSecurity),
        vacationEducationalInsurance: formatMoney(out.deductions.vacationEducationalInsurance),
        thirteenthSocialSecurity: formatMoney(out.deductions.thirteenthSocialSecurity),
        terminationIncomeTax: formatMoney(out.deductions.terminationIncomeTax),
        terminationTaxNote: out.deductions.terminationIncomeTax > 0
          ? `sobre ${formatMoney(out.deductions.terminationTaxable)} gravables, art. 119`
          : 'exento: 1% por año y B/.5,000 deducibles',
        netEstimate: formatMoney(out.netEstimate)
      });
      toggleRows(result, { preaviso: out.preaviso > 0 });
      renderBar($('#termination-bar'), [
        { label: 'Vacaciones', value: out.vacation, tone: 'c' },
        { label: 'Décimo', value: out.thirteenth, tone: 'b' },
        { label: 'Prima', value: out.seniorityPremium, tone: 'a' },
        { label: out.preaviso > 0 ? 'Indemnización y preaviso' : 'Indemnización', value: out.indemnity + out.preaviso, tone: 'd' }
      ], formatMoney);
      const notes = $('#termination-notes');
      notes.replaceChildren(...out.notes.map(note => {
        const p = document.createElement('p');
        p.className = `callout ${note.kind}`;
        p.textContent = note.text;
        return p;
      }));
      summary = `Liquidación ${out.indemnityStatus === 'needs-review' ? 'parcial' : 'estimada'}: ${formatMoney(out.total)} (vacaciones ${formatMoney(out.vacation)}, décimo ${formatMoney(out.thirteenth)}, prima ${formatMoney(out.seniorityPremium)}, indemnización ${out.indemnityStatus === 'needs-review' ? 'requiere revisión y no está incluida' : formatMoney(out.indemnity)}${out.preaviso > 0 ? `, preaviso ${formatMoney(out.preaviso)}` : ''}; neto ${out.indemnityStatus === 'needs-review' ? 'parcial estimado' : 'estimado'} ${formatMoney(out.netEstimate)}). Calculado en Calcula Panamá.`;
    }
  });
  bindShare($<HTMLButtonElement>('#termination-share'), () => summary);
</script>
