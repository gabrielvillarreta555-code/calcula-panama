---
import Layout from '../../layouts/Layout.astro';
import {respuestasPublicadas} from '../../data/responde';
export function getStaticPaths(){return respuestasPublicadas.map(item=>({params:{slug:item.slug},props:{item}}));}
const {item}=Astro.props;
const base=import.meta.env.BASE_URL;
const href=(path:string)=>`${base}${path.replace(/^\//,'')}`;
---
<Layout title={item.seoTitle} description={item.description} canonicalPath={`/responde/${item.slug}/`}>
<article class="container responde-article"><a href={href('/responde/')}>← Todas las preguntas</a><p class="eyebrow">{item.categoria}</p><h1>{item.pregunta}</h1><p class="answer">{item.resumen}</p><h2>Explicación</h2>{item.contenido.map(p=><p>{p}</p>)}<h2>Ejemplo práctico</h2><p>{item.ejemplo}</p><aside class="calculator"><h2>Herramienta relacionada</h2><a href={href(item.calculadora.path)}>{item.calculadora.label} →</a></aside><h2>Fuentes</h2><ul>{item.fuentes.map(source=><li><a href={source.url} rel="noopener noreferrer">{source.title} ↗</a> · consulta: {item.revisado}</li>)}</ul><p>Última revisión editorial: <time datetime={item.revisado}>{item.revisado}</time>.</p><p>Información orientativa; no sustituye asesoría profesional ni la consulta de fuentes oficiales para tu caso.</p></article>
</Layout>
<style>.responde-article{max-width:820px;padding-top:2rem;padding-bottom:4rem;line-height:1.7}.responde-article h1{line-height:1.15}.answer,.calculator{background:var(--surface-2);border:1px solid var(--line);border-radius:var(--radius);padding:1.25rem}.answer{font-size:1.1rem;font-weight:600}.calculator a{font-weight:700}.responde-article li{margin:.6rem 0;overflow-wrap:anywhere}</style>
