---
import EditorialPage from '../../layouts/EditorialPage.astro';
import { GUIDES, CALCULATORS } from '../../data/site';
const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}${p.replace(/^\//, '')}`;
const related = CALCULATORS.map(c => ({ label: c.label, path: c.path, note: c.description }));
---
<EditorialPage title="Guías laborales y del ITBMS en Panamá | Calcula Panamá" description="Guías claras sobre descuentos del salario, décimo tercer mes, prima e indemnización, horas extras e ITBMS en Panamá, con ejemplos y base legal." canonicalPath="/guias/" kicker="Revista · Guías" heading="Guías para Panamá: trabajo e impuestos" lede="Explicaciones cortas, con ejemplos y la norma que respalda cada regla. Cada guía enlaza a la calculadora correspondiente." crumbs={[{ label: 'Guías', path: '/guias/' }]} related={related} relatedTitle="Calculadoras">
  <ul class="toollist ed-big-list">
    {GUIDES.map((g, i) => <li><a href={href(g.path)}><span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><strong>{g.title}</strong><i aria-hidden="true">→</i><small>{g.description}</small></a></li>)}
  </ul>
</EditorialPage>
