---
/** Portada — Midnight Edition (CP-DESIGN-005). Título, descripción, datos estructurados y enlaces internos se conservan. */
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import ToolSearch from '../components/ToolSearch.astro';
import { SITE } from '../data/site';
import { CATEGORIES, MAGAZINE } from '../data/directory';
import { calculateNetSalary } from '../lib/calculations';
import { formatMoney } from '../lib/format';

const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}${p.replace(/^\//, '')}`;
const example = calculateNetSalary({ grossPerPay: 1500, frequency: 'monthly' });
const share = (n: number) => `${((n / example.gross) * 100).toFixed(1)}%`;
const cat = (id: string) => CATEGORIES.find(c => c.id === id)!;
const [movilidad, finanzas, trabajo, cotidiano, educacion] = ['vehiculos', 'finanzas', 'trabajo', 'vida-cotidiana', 'educacion'].map(cat);
const allTools = CATEGORIES.flatMap(c => c.tools);
const schema = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, description: SITE.description, inLanguage: 'es-PA', url: new URL(base, Astro.site ?? Astro.url.origin).toString() },
  { '@context': 'https://schema.org', '@type': 'ItemList', name: 'Herramientas de Calcula Panamá', itemListElement: allTools.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.title, url: new URL(c.path.replace(/^\//, ''), Astro.site ?? Astro.url.origin).toString() })) }
];
const short = (title: string) => title.replace(/^Calculadora (de |del )?/, '').replace(/^Comparador de /, '').replace(/^./, m => m.toUpperCase());
---
<Layout title="Calcula Panamá: calculadoras de salario, finanzas, compras y autos" description="Calculadoras gratuitas para Panamá: salario neto, décimo, liquidación, préstamos, financiamiento de autos, combustible, compras y presupuesto, con fórmulas y fuentes explicadas." canonicalPath="/" schema={schema}>
  <section class="mn-hero" aria-labelledby="hero-title">
    <Photo id="hero" priority sizes="100vw" />
    <div class="container mn-hero-inner">
      <span class="eyebrow">Panamá / Economía / Vida</span>
      <h1 id="hero-title">Decisiones inteligentes. <span>Una vida mejor.</span></h1>
      <p class="lead">Descubre cuánto cuesta lo que realmente importa. Calculadoras gratuitas para Panamá, con fórmulas, fuentes y límites explicados.</p>
      <a class="button primary" href={href('/herramientas/')}>Explorar herramientas <Icon name="external" size={20} /></a>
      <ToolSearch id="home-search" />
    </div>
  </section>

  <section class="mn-section" aria-labelledby="movilidad-title">
    <div class="container">
      <div class="mn-section-head"><h2 id="movilidad-title">{movilidad.label}.</h2><span class="mn-index">{movilidad.number} — {movilidad.kicker}</span></div>
      <div class="mn-split">
        <Photo id="movilidad" class="mn-ratio-photo" />
        <div class="mn-copy">
          <h3>{movilidad.headline}</h3>
          <p>{movilidad.lede}</p>
          <ul class="mn-rows">{movilidad.tools.map(t => <li><a href={href(t.path)}><strong>{short(t.title)}</strong></a><span>{t.description}</span><Icon name="external" size={20} /></li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <section class="mn-section is-midnight" aria-labelledby="finanzas-title">
    <div class="container">
      <span class="mn-index">{finanzas.number} — {finanzas.kicker}</span>
      <div class="mn-split is-reverse" style="margin-top:18px">
        <Photo id="finanzas" class="mn-ratio-tall" />
        <div class="mn-copy">
          <h2 id="finanzas-title" class="mn-feature-title" style="margin-top:0">{finanzas.headline}</h2>
          <p>{finanzas.lede}</p>
          <div class="mn-tiles">
            {finanzas.tools.map((t, i) => <a class="mn-tile" href={href(t.path)}><Icon name={(['spark', 'shield', 'salary'] as const)[i] ?? 'spark'} size={26} /><strong>{['Préstamos', 'Ahorro', 'Mi Quincena'][i] ?? short(t.title)}</strong><span>{t.description}</span></a>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mn-section" id="calculadoras" aria-labelledby="trabajo-title">
    <div class="container">
      <div class="mn-section-head"><h2 id="trabajo-title">{trabajo.label}.</h2><span class="mn-index">{trabajo.number} — {trabajo.kicker}</span></div>
      <div class="mn-split">
        <div>
          <Photo id="trabajo" class="mn-ratio-photo" />
          <aside class="mn-example" aria-label="Ejemplo de salario neto">
            <span class="eyebrow">Ejemplo: salario de {formatMoney(example.gross)} al mes</span>
            <span class="amount">{formatMoney(example.net)}</span>
            <small>neto estimado al mes</small>
            <div class="stack-bar" role="img" aria-label={`Neto ${share(example.net)}, Seguro Social ${share(example.socialSecurity)}, Seguro Educativo ${share(example.educationalInsurance)}, ISR ${share(example.incomeTax)}`} style="margin-top:14px">
              <span class="tone-net" style={`width:${share(example.net)}`}></span>
              <span class="tone-css" style={`width:${share(example.socialSecurity)}`}></span>
              <span class="tone-edu" style={`width:${share(example.educationalInsurance)}`}></span>
              <span class="tone-isr" style={`width:${share(example.incomeTax)}`}></span>
            </div>
            <ul class="breakdown">
              <li class="minus"><span>Seguro Social 9.75%</span><strong>{formatMoney(example.socialSecurity)}</strong></li>
              <li class="minus"><span>Seguro Educativo 1.25%</span><strong>{formatMoney(example.educationalInsurance)}</strong></li>
              <li class="minus"><span>ISR estimado</span><strong>{formatMoney(example.incomeTax)}</strong></li>
            </ul>
            <a href={href('/calculadoras/salario-neto/#como-se-calcula')}>Entender este cálculo</a>
          </aside>
        </div>
        <div class="mn-copy">
          <h3>{trabajo.headline}</h3>
          <p>{trabajo.lede}</p>
          <ul class="mn-rows">{trabajo.tools.map(t => <li><a href={href(t.path)}><strong>{t.title}</strong></a><span>{t.description}</span><Icon name="external" size={20} /></li>)}</ul>
          <div class="mn-dates" aria-labelledby="fechas-decimo">
            <h3 id="fechas-decimo" class="eyebrow" style="margin:30px 0 12px">Fechas de pago del décimo tercer mes</h3>
            <div class="dates-strip" id="decimo-dates">
              <div class="date-chip" data-month="4"><strong>15 abr</strong><span>16 dic – 15 abr</span></div>
              <div class="date-chip" data-month="8"><strong>15 ago</strong><span>16 abr – 15 ago</span></div>
              <div class="date-chip" data-month="12"><strong>15 dic</strong><span>16 ago – 15 dic</span></div>
            </div>
            <p class="muted" style="margin-top:12px">Cada partida cubre cuatro meses. <a href={href('/guias/fechas-de-pago-del-decimo-tercer-mes/')}>Ver períodos y reglas</a>.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mn-section is-midnight" aria-labelledby="cotidiano-title">
    <div class="container">
      <div class="mn-section-head"><h2 id="cotidiano-title">{cotidiano.label}.</h2><span class="mn-index">{cotidiano.number} — {cotidiano.kicker}</span></div>
      <div class="mn-split is-reverse">
        <Photo id="cotidiano" class="mn-ratio-photo" />
        <div class="mn-copy">
          <h3>{cotidiano.headline}</h3>
          <p>{cotidiano.lede}</p>
          <ul class="mn-rows">{cotidiano.tools.map(t => <li><a href={href(t.path)}><strong>{short(t.title)}</strong></a><span>{t.description}</span><Icon name="external" size={20} /></li>)}</ul>
          <p style="margin-top:18px"><a class="button secondary" href={href('/compras/')}>Compras y gastos: guía de uso</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="mn-section" aria-labelledby="educacion-title">
    <div class="container mn-split">
      <div class="mn-copy">
        <span class="mn-index">{educacion.number} — {educacion.kicker}</span>
        <h2 id="educacion-title" class="mn-feature-title" style="margin-top:14px">{educacion.headline}</h2>
        <p>{educacion.lede}</p>
      </div>
      <ul class="mn-rows" style="margin-top:0">{educacion.tools.map(t => <li><a href={href(t.path)}><strong>{t.title}</strong></a><span>{t.description}</span><Icon name="external" size={20} /></li>)}</ul>
    </div>
  </section>

  <section class="mn-section is-midnight" aria-labelledby="revista-title">
    <div class="container">
      <span class="mn-index">Revista / Guías</span>
      <h2 id="revista-title" class="mn-feature-title" style="font-size:clamp(2rem,6vw,3.6rem)">Conocimiento que vale.</h2>
      <div class="mn-magazine">
        <a href={href(MAGAZINE[0]!.path)} style="text-decoration:none;color:inherit">
          <Photo id="revista" class="mn-ratio-wide" />
          <h3 class="mn-feature-title">Entender la economía de nuestra vida cotidiana.</h3>
          <p class="muted">Guías prácticas para tomar mejores decisiones en Panamá, con ejemplos y la norma que respalda cada regla.</p>
        </a>
        <ul class="mn-rows">{MAGAZINE.map(g => <li><a href={href(g.path)}><strong>{g.title}</strong></a><span>{g.description}</span><Icon name="external" size={20} /></li>)}</ul>
      </div>
    </div>
  </section>

  <section class="mn-section" aria-label="Cómo trabajamos">
    <div class="container mn-principles">
      <div><h3>Privado por diseño</h3><p>Los cálculos se hacen en tu navegador. No pedimos nombre, cédula ni correo, y no enviamos tus cifras a ningún servidor.</p></div>
      <div><h3>Con fuentes</h3><p>Las calculadoras laborales citan el artículo de cada regla (Código de Trabajo, Ley Orgánica de la CSS y Código Fiscal), y las financieras, los acuerdos de la Superintendencia de Bancos.</p></div>
      <div><h3>Sin falsa precisión</h3><p>Cuando un caso depende de datos que no tenemos o de una interpretación jurídica, te lo decimos en lugar de inventar una cifra.</p></div>
    </div>
  </section>
</Layout>

<script is:inline>
  (function () {
    var d = new Date(), md = (d.getMonth() + 1) * 100 + d.getDate();
    var next = md >= 1216 || md <= 415 ? 4 : md <= 815 ? 8 : 12;
    var chip = document.querySelector('#decimo-dates [data-month="' + next + '"]');
    if (chip) { chip.classList.add('next'); chip.insertAdjacentHTML('beforeend', '<span style="display:block;color:var(--brand-2);font-weight:700">Próxima</span>'); }
  })();
</script>
