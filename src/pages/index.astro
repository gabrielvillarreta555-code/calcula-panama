---
/**
 * Portada editorial Midnight Edition (CP-DESIGN-006), integrada en el sitio.
 * Origen: docs/cp-design-006/prototipos/index.html (rama design/cp-design-005-midnight), portado sin cambios de
 * composición. Se sustituyen los enlaces de ejemplo por las rutas reales y las cifras fijas por datos del sitio.
 * El <head> (título, descripción, canónica, datos estructurados, CSP y política de publicidad) es el de antes.
 */
import Layout from '../layouts/Layout.astro';
import EdPicture from '../components/editorial/EdPicture.astro';
import EdMasthead from '../components/editorial/EdMasthead.astro';
import EdColophon from '../components/editorial/EdColophon.astro';
import { CALCULATORS, GUIDES, SITE } from '../data/site';
import { expansionTools, vehicleTools } from '../data/expansion-tools';
import { calculateNetSalary } from '../lib/calculations';
import { formatMoney } from '../lib/format';

const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}${p.replace(/^\//, '')}`;

// Datos estructurados: idénticos a la portada anterior.
const allTools = [
  ...CALCULATORS.map(c => ({ name: c.label, path: c.path })),
  { name: 'Mi Quincena', path: '/finanzas/mi-quincena/' },
  { name: 'Calculadora de préstamos', path: '/finanzas/calculadora-prestamos/' },
  { name: 'Modo Pasillo', path: '/compras/modo-pasillo/' },
  { name: 'Calculadora de horas extras', path: '/calculadoras/horas-extras/' },
  ...[...expansionTools, ...vehicleTools].map(t => ({ name: t.title, path: t.path }))
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, description: SITE.description, inLanguage: 'es-PA', url: new URL(base, Astro.site ?? Astro.url.origin).toString() },
  { '@context': 'https://schema.org', '@type': 'ItemList', name: 'Herramientas de Calcula Panamá', itemListElement: allTools.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, url: new URL(c.path.replace(/^\//, ''), Astro.site ?? Astro.url.origin).toString() })) }
];

// «El dato»: cifra del motor real de salario neto.
const example = calculateNetSalary({ grossPerPay: 1500, frequency: 'monthly' });
const pct = (n: number) => (n / example.gross) * 100;
const fmtPct = (n: number) => `${new Intl.NumberFormat('es-PA', { maximumFractionDigits: 2 }).format(pct(n))} %`;
const [netInt, netCents] = formatMoney(example.net).replace(/^B\/\.\s?/, '').split('.');

// Secciones del prototipo con las rutas reales.
type Tool = { n: string; name: string; desc: string; path: string; group?: 'hogar' | 'compras' };
const sections: { id: string; num: string; name: string; deck: string; tools: Tool[] }[] = [
  { id: 'movilidad', num: '01', name: 'Movilidad', deck: 'Más allá del precio.', tools: [
    { n: '1.1', name: 'Financiamiento de autos', desc: 'Letra, tasa efectiva y tabla de amortización.', path: '/vehiculos/financiamiento-de-auto/' },
    { n: '1.2', name: 'Combustible por viaje', desc: 'Litros, galones y costo por persona.', path: '/vehiculos/combustible-por-viaje/' },
    { n: '1.3', name: 'Costo mensual de un auto', desc: 'Letra, seguro, mantenimiento y costo por kilómetro.', path: '/vehiculos/costo-mensual-de-un-auto/' }] },
  { id: 'finanzas', num: '02', name: 'Finanzas', deck: 'Tu futuro comienza hoy.', tools: [
    { n: '2.1', name: 'Préstamos', desc: 'Cuota, intereses y costo total.', path: '/finanzas/calculadora-prestamos/' },
    { n: '2.2', name: 'Metas de ahorro', desc: 'Cuánto apartar por quincena o por mes.', path: '/finanzas/meta-de-ahorro/' },
    { n: '2.3', name: 'Mi Quincena', desc: 'Tu dinero disponible hasta el próximo pago.', path: '/finanzas/mi-quincena/' },
    { n: '2.4', name: 'Tarjeta de crédito', desc: 'Intereses, pago mínimo y cuándo terminas de pagar.', path: '/finanzas/tarjeta-de-credito/' }] },
  { id: 'trabajo', num: '03', name: 'Trabajo', deck: 'El valor de tu esfuerzo.', tools: [
    { n: '3.1', name: 'Salario neto', desc: 'Seguro Social, Seguro Educativo e ISR.', path: '/calculadoras/salario-neto/' },
    { n: '3.2', name: 'Décimo tercer mes', desc: 'Partidas del 15 de abril, agosto y diciembre.', path: '/calculadoras/decimo-tercer-mes/' },
    { n: '3.3', name: 'Vacaciones', desc: 'Días acumulados y pago proporcional.', path: '/calculadoras/vacaciones/' },
    { n: '3.4', name: 'Liquidación laboral', desc: 'Prima de antigüedad, indemnización y preaviso.', path: '/calculadoras/liquidacion-laboral/' },
    { n: '3.5', name: 'Horas extras', desc: 'Recargos del 25%, 50% y 75%, domingos y feriados.', path: '/calculadoras/horas-extras/' },
    { n: '3.6', name: 'Salario mínimo', desc: 'Tasa por hora de tu actividad y su equivalente mensual.', path: '/calculadoras/salario-minimo/' }] },
  { id: 'hogar', num: '04', name: 'Hogar y compras', deck: 'El costo de vivir.', tools: [
    { n: '4.1', name: 'Consumo eléctrico', desc: 'kWh de cada aparato y su costo con tu tarifa.', path: '/vida-cotidiana/consumo-electrico/', group: 'hogar' },
    { n: '4.2', name: 'Días hábiles y feriados', desc: 'Días laborables entre dos fechas y feriados de 2027.', path: '/vida-cotidiana/dias-habiles-y-feriados/', group: 'hogar' },
    { n: '4.3', name: 'Hipoteca', desc: 'Letra, abono, seguros y gastos iniciales.', path: '/vivienda/calculadora-de-hipoteca/', group: 'hogar' },
    { n: '4.4', name: 'Capacidad de compra', desc: 'Cuánta vivienda puedes pagar con tu ingreso.', path: '/vivienda/capacidad-de-compra/', group: 'hogar' },
    { n: '4.5', name: 'Alquilar o comprar', desc: 'Tu patrimonio en cada opción, año por año.', path: '/vivienda/alquilar-o-comprar/', group: 'hogar' },
    { n: '4.6', name: 'Modo Pasillo', desc: 'Suma tu compra mientras recorres el supermercado.', path: '/compras/modo-pasillo/', group: 'compras' },
    { n: '4.7', name: 'Descuentos y promociones', desc: 'El ahorro real de un 2x1 o un 3x2.', path: '/compras/descuentos-y-promociones/', group: 'compras' },
    { n: '4.8', name: 'Precio por unidad', desc: 'Libra, kilo o litro: qué sale más barato.', path: '/compras/precio-por-unidad/', group: 'compras' },
    { n: '4.9', name: 'ITBMS', desc: 'Agrega o separa el 7%, 10% o 15% de un precio.', path: '/impuestos/itbms/', group: 'compras' },
    { n: '4.10', name: 'Dividir la cuenta', desc: 'Partes iguales, propina y redondeo.', path: '/compras/dividir-la-cuenta/', group: 'compras' }] },
  { id: 'educacion', num: '05', name: 'Educación', deck: 'Cuentas claras para estudiar.', tools: [
    { n: '5.1', name: 'Promedio de notas', desc: 'Tu promedio ponderado y la nota que necesitas.', path: '/educacion/promedio-de-notas/' }] }
];
const byId = Object.fromEntries(sections.map(s => [s.id, s]));
const toolCount = new Set(sections.flatMap(s => s.tools.map(t => t.path))).size;
const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
const guides = GUIDES;
---
<Layout title="Calcula Panamá: calculadoras de salario, finanzas, compras y autos" description="Calculadoras gratuitas para Panamá: salario neto, décimo, liquidación, préstamos, financiamiento de autos, combustible, compras y presupuesto, con fórmulas y fuentes explicadas." canonicalPath="/" schema={schema} variant="editorial">
  <Fragment slot="masthead">
    <EdMasthead home />
    <figure class="photo ed-hero-photo">
      <EdPicture name="hero" dir="fotos" height={567} eager sizes="100vw" alt="Rascacielos de la ciudad de Panamá iluminados al anochecer, reflejados en la bahía." />
    </figure>
    <div class="wrap"><div class="photo"><figcaption><span>Ciudad de Panamá al anochecer · Fotografía real</span><span>Elemaki · <a href="https://creativecommons.org/licenses/by/3.0" rel="noopener noreferrer" target="_blank">CC BY 3.0</a></span></figcaption></div></div>
  </Fragment>

  <section class="wrap grid ed-hero">
    <h1>Decisiones inteligentes. <em>Una vida mejor.</em></h1>
    <div class="ed-hero-side">
      <p>Descubre cuánto cuesta lo que realmente importa. Calculadoras gratuitas para Panamá, con fórmulas, fuentes y límites explicados.</p>
      <a class="arrow-link" href="#indice">Explorar herramientas <span>→</span></a>
      <div>
        <label class="search"><span aria-hidden="true">⌕</span><input type="search" placeholder="¿Qué necesitas calcular?" aria-label="Buscar una herramienta" autocomplete="off" data-search="hero" /></label>
        <ul class="toollist ed-results" data-results="hero" hidden></ul>
      </div>
    </div>
  </section>

  <section class="wrap index hair" id="indice" aria-labelledby="indice-t">
    <div class="index-head"><h2 class="label" id="indice-t">Índice</h2><span class="label">{plural(toolCount, 'herramienta', 'herramientas')} · {plural(guides.length, 'guía', 'guías')}</span></div>
    <ol>
      {sections.map(s => <li><a href={`#${s.id}`}><span class="num">{s.num}</span><span class="name">{s.name}</span><span class="deck">{s.deck}</span><span class="count">{plural(s.tools.length, 'herramienta', 'herramientas')} →</span></a></li>)}
      <li><a href="#revista"><span class="num">—</span><span class="name">Revista</span><span class="deck">Conocimiento que vale.</span><span class="count">{plural(guides.length, 'guía', 'guías')} →</span></a></li>
    </ol>
  </section>

  <section class="wrap grid datum hair" aria-labelledby="dato-t">
    <h2 class="label" id="dato-t" style="grid-column:1/-1">El dato</h2>
    <p class="figure"><small>B/.</small>{netInt}.{netCents}</p>
    <p>Es lo que recibe al mes quien gana {formatMoney(example.gross)} brutos en Panamá, después del Seguro Social, el Seguro Educativo y el impuesto sobre la renta.</p>
    <div class="bar" role="img" aria-label={`Neto ${fmtPct(example.net)}, Seguro Social ${fmtPct(example.socialSecurity)}, Seguro Educativo ${fmtPct(example.educationalInsurance)}, ISR ${fmtPct(example.incomeTax)}`}><span style={`flex:${pct(example.net)};background:var(--ivory)`}></span><span style={`flex:${pct(example.socialSecurity)};background:var(--silver)`}></span><span style={`flex:${pct(example.educationalInsurance)};background:#5a7593`}></span><span style={`flex:${pct(example.incomeTax)};background:var(--steel)`}></span></div>
    <div class="legend"><span><b>{fmtPct(example.net)}</b> neto</span><span><b>{fmtPct(example.socialSecurity)}</b> Seguro Social</span><span><b>{fmtPct(example.educationalInsurance)}</b> Seguro Educativo</span><span><b>{fmtPct(example.incomeTax)}</b> ISR</span></div>
    <a class="arrow-link cta" href={href('/calculadoras/salario-neto/')}>Calcula tu salario neto <span>→</span></a>
  </section>

  <section class="wrap grid ed-feature hair" id="movilidad" aria-labelledby="mov-t">
    <figure class="photo bleed-left"><EdPicture name="movilidad" ratio="4/3" alt="Camioneta pickup negra estacionada de noche junto a un edificio de concreto (imagen ilustrativa)." /><figcaption><span>Camioneta pickup · Imagen ilustrativa. Calcula Panamá no tiene afiliación con Toyota ni con sus marcas</span><span>Recurso de Calcula Panamá</span></figcaption></figure>
    <div class="text">
      <span class="label">01 — Movilidad</span>
      <h2 id="mov-t">Más allá del precio.</h2>
      <p class="lede">Comprar, financiar y mantener tu próximo vehículo, con la tasa y los costos que tú escribes.</p>
      <ul class="toollist">{byId.movilidad!.tools.map(t => <li><a href={href(t.path)}><span class="n">{t.n}</span><strong>{t.name}</strong><i aria-hidden="true">→</i><small>{t.desc}</small></a></li>)}</ul>
    </div>
  </section>

  <section class="wrap grid ed-feature reverse hair" id="finanzas" aria-labelledby="fin-t">
    <figure class="photo bleed-right"><EdPicture name="finanzas" ratio="4/5" alt="Escritorio de oficina frente a un ventanal con vista nocturna de la ciudad de Panamá." /><figcaption><span>Oficina panorámica · Imagen ilustrativa</span><span>Recurso de Calcula Panamá</span></figcaption></figure>
    <div class="text">
      <span class="label">02 — Finanzas</span>
      <h2 id="fin-t">Tu futuro comienza hoy.</h2>
      <p class="lede">Préstamos, metas de ahorro y el dinero de tu quincena, con ejemplos que puedes comprobar.</p>
      <ul class="toollist">{byId.finanzas!.tools.map(t => <li><a href={href(t.path)}><span class="n">{t.n}</span><strong>{t.name}</strong><i aria-hidden="true">→</i><small>{t.desc}</small></a></li>)}</ul>
    </div>
  </section>

  <section class="wrap grid ed-feature hair" id="trabajo" aria-labelledby="tra-t">
    <figure class="photo bleed-left">
      <EdPicture name="trabajo" dir="fotos" height={953} ratio="3/2" alt="Esclusas de Miraflores del Canal de Panamá." />
      <figcaption><span>Esclusas de Miraflores, Canal de Panamá · Fotografía real</span><span>GameOfLight · <a href="https://creativecommons.org/licenses/by-sa/3.0" rel="noopener noreferrer" target="_blank">CC BY-SA 3.0</a></span></figcaption>
    </figure>
    <div class="text">
      <span class="label">03 — Trabajo</span>
      <h2 id="tra-t">El valor de tu esfuerzo.</h2>
      <p class="lede">Salario neto, décimo tercer mes, vacaciones y liquidación, con la norma que respalda cada regla.</p>
      <ul class="toollist">{byId.trabajo!.tools.map(t => <li><a href={href(t.path)}><span class="n">{t.n}</span><strong>{t.name}</strong><i aria-hidden="true">→</i><small>{t.desc}</small></a></li>)}</ul>
      <p class="label" id="decimo-next"><a href={href('/guias/fechas-de-pago-del-decimo-tercer-mes/')}>Décimo: pagos el 15 de abril, agosto y diciembre →</a></p>
    </div>
  </section>

  <section class="wrap grid columns hair" id="hogar" aria-label="Hogar y compras">
    <section>
      <figure class="photo"><EdPicture name="hogar" ratio="3/2" alt="Sala de un apartamento con vista al atardecer sobre los edificios de la ciudad." /><figcaption><span>Apartamento moderno · Imagen ilustrativa</span><span>Recurso de Calcula Panamá</span></figcaption></figure>
      <span class="label" style="display:block;margin-top:22px">04 — Hogar</span>
      <h2>El costo de vivir.</h2>
      <ul class="toollist">{byId.hogar!.tools.filter(t => t.group === 'hogar').map(t => <li><a href={href(t.path)}><span class="n">{t.n}</span><strong>{t.name}</strong><i aria-hidden="true">→</i><small>{t.desc}</small></a></li>)}</ul>
    </section>
    <section>
      <figure class="photo"><EdPicture name="compras" ratio="3/2" alt="Carrito con frutas, verduras y productos en el pasillo de un supermercado." /><figcaption><span>Supermercado · Imagen ilustrativa</span><span>Recurso de Calcula Panamá</span></figcaption></figure>
      <span class="label" style="display:block;margin-top:22px">04 — Compras</span>
      <h2>Del estante al carrito.</h2>
      <ul class="toollist">{byId.hogar!.tools.filter(t => t.group === 'compras').map(t => <li><a href={href(t.path)}><span class="n">{t.n}</span><strong>{t.name}</strong><i aria-hidden="true">→</i><small>{t.desc}</small></a></li>)}</ul>
    </section>
  </section>

  <section class="wrap grid ed-feature reverse hair" id="educacion" aria-labelledby="edu-t">
    <figure class="photo bleed-right"><EdPicture name="educacion" ratio="16/10" alt="Mesa de estudio con libros y cuadernos en una biblioteca con vista a la ciudad." /><figcaption><span>Biblioteca moderna · Imagen ilustrativa</span><span>Recurso de Calcula Panamá</span></figcaption></figure>
    <div class="text">
      <span class="label">05 — Educación</span>
      <h2 id="edu-t">Cuentas claras para estudiar.</h2>
      <ul class="toollist">{byId.educacion!.tools.map(t => <li><a href={href(t.path)}><span class="n">{t.n}</span><strong>{t.name}</strong><i aria-hidden="true">→</i><small>{t.desc}</small></a></li>)}</ul>
    </div>
  </section>

  <section class="wrap magazine hair" id="revista" aria-labelledby="rev-t">
    <span class="label">Revista · Guías</span>
    <h2 id="rev-t">Conocimiento que vale.</h2>
    <div class="grid articles">
      <article class="lead">
        <figure class="photo"><EdPicture name="revista" ratio="16/10" alt="Escritorio con cuaderno, calculadora, informes y café, iluminado por una lámpara." /><figcaption><span>Escritorio editorial · Imagen ilustrativa</span><span>Recurso de Calcula Panamá</span></figcaption></figure>
        <div style="display:flex;flex-direction:column;gap:14px;justify-content:end">
          <span class="label">Guía · {guides[0]!.topic}</span>
          <h3><a href={href(guides[0]!.path)}>{guides[0]!.title}</a></h3>
          <p>{guides[0]!.description}</p>
          <div class="meta"><span>Con tablas de ejemplo</span><span>·</span><span>Norma citada</span></div>
        </div>
      </article>
      {guides.slice(1).map(g => <article><span class="label">Guía · {g.topic}</span><h3><a href={href(g.path)}>{g.title}</a></h3><p>{g.description}</p></article>)}
      <article><span class="label">Principios</span><h3><a href={href('/sobre-nosotros/')}>Privado, con fuentes y sin falsa precisión</a></h3><p>Los cálculos ocurren en tu navegador; cada regla cita su norma.</p></article>
    </div>
  </section>

  <Fragment slot="colophon">
    <EdColophon home />
  </Fragment>
</Layout>
