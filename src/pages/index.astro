---
import Layout from '../layouts/Layout.astro';
import AdSlot from '../components/AdSlot.astro';
const base = import.meta.env.BASE_URL;
const href = (p:string) => `${base}${p.replace(/^\//,'')}`;
const schema={ '@context':'https://schema.org','@type':'WebSite',name:'Calcula Panamá',description:'Calculadoras laborales gratuitas para Panamá',inLanguage:'es-PA' };
---
<Layout title="Calcula Panamá | Calculadoras laborales gratuitas" description="Calcula salario neto, décimo tercer mes y liquidación laboral en Panamá con desglose, fórmulas y fuentes oficiales." schema={schema}>
  <section class="hero"><div class="container"><span class="eyebrow">Hecho para Panamá</span><h1>Tus números laborales, mucho más claros.</h1><p>Calculadoras gratuitas para estimar tu salario neto, décimo tercer mes y liquidación. Sin cuentas, sin enviar tus datos y con cada fórmula explicada.</p><div class="actions"><a class="button primary" href={href('/calculadoras/salario-neto/')}>Calcular mi salario →</a><a class="button secondary" href="#calculadoras">Ver calculadoras</a></div><div class="trust-row"><span>✓ Cálculos en tu dispositivo</span><span>✓ Fuentes identificadas</span><span>✓ Gratis y sin registro</span></div></div></section>
  <section class="section" id="calculadoras"><div class="container"><div class="section-title"><span class="eyebrow">Herramientas</span><h2>Empieza con lo que necesitas calcular</h2><p>Cada resultado incluye un desglose comprensible, los supuestos utilizados y límites que conviene revisar.</p></div><div class="cards">
    <article class="card"><div class="card-icon">B/.</div><h3>Salario neto</h3><p>Estima Seguro Social, Seguro Educativo, impuesto sobre la renta y pago disponible.</p><a class="card-link" href={href('/calculadoras/salario-neto/')}>Abrir calculadora →</a></article>
    <article class="card"><div class="card-icon">⅓</div><h3>Décimo tercer mes</h3><p>Calcula una partida desde tus remuneraciones reales del período, incluidas las variables.</p><a class="card-link" href={href('/calculadoras/decimo-tercer-mes/')}>Abrir calculadora →</a></article>
    <article class="card"><div class="card-icon">≋</div><h3>Liquidación laboral</h3><p>Distingue vacaciones, décimo proporcional, prima de antigüedad e indemnización aplicable.</p><a class="card-link" href={href('/calculadoras/liquidacion-laboral/')}>Abrir calculadora →</a></article>
  </div><AdSlot /></div></section>
  <section class="section"><div class="container"><div class="panel"><div class="section-title"><span class="eyebrow">Privacidad primero</span><h2>Tus cifras no salen de tu teléfono</h2><p>Los cálculos se ejecutan localmente en el navegador. No pedimos nombre, cédula, correo ni almacenamos salarios. El código está organizado para actualizar las reglas legales sin rehacer la interfaz.</p></div><div class="pill-row"><span class="pill">Sin registro</span><span class="pill">Sin base de datos</span><span class="pill">Sin rastreo salarial</span><span class="pill">Accesible</span></div></div></div></section>
</Layout>
