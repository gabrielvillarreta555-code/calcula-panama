---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import ToolSearch from '../../components/ToolSearch.astro';
import { CATEGORIES } from '../../data/directory';
import '../../styles/expansion-tools.css';
const href = (path: string) => `${import.meta.env.BASE_URL}${path.replace(/^\//, '')}`;
---
<Layout title="Herramientas y calculadoras gratuitas | Calcula Panamá" description="Encuentra calculadoras de compras, ahorro, autos, salarios, notas y consumo eléctrico. Herramientas gratuitas con ejemplos y límites explicados." canonicalPath="/herramientas/">
  <div class="container tools-page">
    <header class="tool-heading"><p class="eyebrow">Tu día, con las cuentas claras</p><h1>Herramientas y calculadoras</h1><p>Elige lo que necesitas resolver. Cada herramienta explica sus datos, su cálculo y sus límites.</p></header>
    <ToolSearch id="directory-search" />
    <nav class="tool-categories" aria-label="Categorías de herramientas">{CATEGORIES.map(category => <a href={`#${category.id}`}>{category.label}</a>)}</nav>
    {CATEGORIES.map(category => <section id={category.id} class="tool-category mn-section" aria-labelledby={`title-${category.id}`}>
      {category.id === 'vida-cotidiana' && <span id="compras"></span>}
      <div class="mn-section-head"><h2 id={`title-${category.id}`}>{category.label}</h2><span class="mn-index">{category.number} — {category.kicker}</span></div>
      <p class="muted">{category.lede}</p>
      <ul class="mn-rows tool-directory">{category.tools.map(tool => <li class="tool-card"><a href={href(tool.path)}><strong>{tool.title}</strong></a><span>{tool.description}</span><Icon name="external" size={20} /></li>)}</ul>
    </section>)}
  </div>
</Layout>
