---
/** Directorio de herramientas en Midnight Editorial (CP-DESIGN-008): índice numerado y listas de la portada. */
import EditorialPage from '../../layouts/EditorialPage.astro';
import { expansionTools, vehicleTools } from '../../data/expansion-tools';
import { CALCULATORS } from '../../data/site';
import { OVERTIME_TOOL } from '../../data/launch';
const href = (path: string) => `${import.meta.env.BASE_URL}${path.replace(/^\//, '')}`;
const categories = [
  { id: 'compras', name: 'Compras', tools: [{ title: 'Modo Pasillo', description: 'Suma los productos de tu compra y controla tu presupuesto.', path: '/compras/modo-pasillo/' }, ...expansionTools.filter(t => t.category === 'Compras')] },
  { id: 'finanzas', name: 'Finanzas', tools: [{ title: 'Mi Quincena', description: 'Organiza tu dinero disponible hasta el próximo pago.', path: '/finanzas/mi-quincena/' }, { title: 'Calculadora de préstamos', description: 'Estima una cuota según el monto, la tasa y el plazo.', path: '/finanzas/calculadora-prestamos/' }, ...expansionTools.filter(t => t.category === 'Finanzas')] },
  { id: 'vehiculos', name: 'Vehículos', tools: vehicleTools },
  { id: 'trabajo', name: 'Trabajo y salarios', tools: [...CALCULATORS.map(t => ({ ...t, title: t.label })), ...(OVERTIME_TOOL.published ? [{ title: 'Calculadora de horas extras', description: OVERTIME_TOOL.description, path: OVERTIME_TOOL.path }] : []), ...expansionTools.filter(t => t.category === 'Trabajo')] },
  { id: 'vivienda', name: 'Vivienda', tools: expansionTools.filter(t => t.category === 'Vivienda') },
  { id: 'impuestos', name: 'Impuestos', tools: expansionTools.filter(t => t.category === 'Impuestos') },
  { id: 'educacion', name: 'Educación', tools: expansionTools.filter(t => t.category === 'Educación') },
  { id: 'vida-cotidiana', name: 'Vida cotidiana', tools: expansionTools.filter(t => t.category === 'Vida cotidiana') },
];
const plural = (n: number) => `${n} ${n === 1 ? 'herramienta' : 'herramientas'}`;
---
<EditorialPage title="Herramientas y calculadoras gratuitas | Calcula Panamá" description="Calculadoras gratuitas para Panamá: salarios, horas extras, ITBMS, préstamos, tarjeta, autos, compras, feriados y más, con ejemplos y fuentes." canonicalPath="/herramientas/" kicker="Tu día, con las cuentas claras" heading="Herramientas y calculadoras" lede="Elige lo que necesitas resolver. Cada herramienta explica sus datos, su cálculo y sus límites." wide>
  <nav class="index ed-index" aria-label="Categorías de herramientas">
    <ol>{categories.map((c, i) => <li><a href={`#${c.id}`}><span class="num">{String(i + 1).padStart(2, '0')}</span><span class="name">{c.name}</span><span class="count">{plural(c.tools.length)} →</span></a></li>)}</ol>
  </nav>
  {categories.map((category, i) => <section id={category.id} class="ed-category" aria-labelledby={`title-${category.id}`}>
    <span class="label">{String(i + 1).padStart(2, '0')} — {category.name}</span>
    <h2 id={`title-${category.id}`}>{category.name}</h2>
    {category.id === 'compras' && <p><a class="arrow-link" href={href('/compras/')}>Guía de compras y gastos <span>→</span></a></p>}
    <ul class="toollist">{category.tools.map((tool, j) => <li><a href={href(tool.path)}><span class="n" aria-hidden="true">{i + 1}.{j + 1}</span><strong>{tool.title}</strong><i aria-hidden="true">→</i><small>{tool.description}</small></a></li>)}</ul>
  </section>)}
</EditorialPage>
