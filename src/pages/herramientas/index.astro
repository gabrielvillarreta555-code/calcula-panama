---
import Layout from '../../layouts/Layout.astro';
import { expansionTools, vehicleTools } from '../../data/expansion-tools';
import { CALCULATORS } from '../../data/site';
import '../../styles/expansion-tools.css';
const href = (path: string) => `${import.meta.env.BASE_URL}${path.replace(/^\//, '')}`;
const categories = [
  { id: 'compras', name: 'Compras', tools: [{ title: 'Modo Pasillo', description: 'Suma los productos de tu compra y controla tu presupuesto.', path: '/compras/modo-pasillo/' }, ...expansionTools.filter(t => t.category === 'Compras')] },
  { id: 'finanzas', name: 'Finanzas', tools: [{ title: 'Mi Quincena', description: 'Organiza tu dinero disponible hasta el próximo pago.', path: '/finanzas/mi-quincena/' }, { title: 'Calculadora de préstamos', description: 'Estima una cuota según el monto, la tasa y el plazo.', path: '/finanzas/calculadora-prestamos/' }, ...expansionTools.filter(t => t.category === 'Finanzas')] },
  { id: 'vehiculos', name: 'Vehículos', tools: vehicleTools },
  { id: 'trabajo', name: 'Trabajo y salarios', tools: CALCULATORS.map(t => ({ ...t, title: t.label })) },
  { id: 'educacion', name: 'Educación', tools: expansionTools.filter(t => t.category === 'Educación') },
  { id: 'vida-cotidiana', name: 'Vida cotidiana', tools: expansionTools.filter(t => t.category === 'Vida cotidiana') },
];
---
<Layout title="Herramientas y calculadoras gratuitas | Calcula Panamá" description="Encuentra calculadoras de compras, ahorro, autos, salarios, notas y consumo eléctrico. Herramientas gratuitas con ejemplos y límites explicados." canonicalPath="/herramientas/">
  <div class="container tools-page">
    <header class="tool-heading"><p class="eyebrow">Tu día, con las cuentas claras</p><h1>Herramientas y calculadoras</h1><p>Elige lo que necesitas resolver. Cada herramienta explica sus datos, su cálculo y sus límites.</p></header>
    <nav class="tool-categories" aria-label="Categorías de herramientas">{categories.map(category => <a href={`#${category.id}`}>{category.name}</a>)}</nav>
    {categories.map(category => <section id={category.id} class="tool-category" aria-labelledby={`title-${category.id}`}>
      <h2 id={`title-${category.id}`}>{category.name}</h2>
      <div class="tool-directory">{category.tools.map(tool => <article class="tool-card"><h3><a href={href(tool.path)}>{tool.title}</a></h3><p>{tool.description}</p></article>)}</div>
    </section>)}
  </div>
</Layout>
