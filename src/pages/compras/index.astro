---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path.replace(/^\//, '')}`;
---
<Layout title="Compras y gastos | Calcula Panamá" description="Herramientas privadas para controlar compras y gastos cotidianos desde tu teléfono." canonicalPath="/compras/">
  <header class="page-head">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Inicio', path: '/' }, { label: 'Compras y gastos' }]} />
      <span class="eyebrow">Nuevo módulo</span>
      <h1>Compras y gastos</h1>
      <p>Herramientas sencillas para tomar decisiones cotidianas sin enviar tus datos a ningún servidor.</p>
    </div>
  </header>
  <section class="section">
    <div class="container">
      <div class="cards">
        <a class="card" href={href('/compras/modo-pasillo/')}>
          <span class="card-icon icon-salary"><Icon name="salary" /></span>
          <h2>Modo Pasillo</h2>
          <p>Suma precios y cantidades mientras compras, compara el total con tu presupuesto y conoce el saldo al instante.</p>
          <span class="card-link">Abrir herramienta <Icon name="arrow" size={16} /></span>
        </a>
      </div>
      <p class="notice" style="margin-top:1.5rem">Esta versión no aplica ITBMS, descuentos ni promociones automáticamente. Introduce el precio final que deseas sumar.</p>
    </div>
  </section>
</Layout>
