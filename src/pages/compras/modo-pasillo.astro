---
import Layout from '../../layouts/Layout.astro';
import FxCrumb from '../../components/fx/FxCrumb.astro';
import FxIcon from '../../components/fx/FxIcon.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Modo Pasillo',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'PAB' }
};
---
<Layout title="Modo Pasillo: calculadora de compras y presupuesto | Calcula Panamá" description="Suma productos, cantidades y precios mientras compras. Controla tu presupuesto en el teléfono sin guardar ni enviar tus datos." canonicalPath="/compras/modo-pasillo/" schema={schema} variant="functional">
  <div class="fx-wrap fx-aisle" id="aisle-mode">
    <FxCrumb items={[{ label: 'Compras y gastos', path: '/compras/' }, { label: 'Modo Pasillo', path: '/compras/modo-pasillo/' }]} />
    <div class="fx-title"><FxIcon name="cart" size={22} framed class="is-lg" /><h1>Modo Pasillo</h1></div>
    <p class="fx-lede">Tu compra, clara y bajo control.</p>

    <div class="fx-aisle-stack">
      <section class="fx-panel aisle-summary" aria-label="Resumen de la compra" aria-live="polite">
        <span class="fx-overline" style="display:flex;justify-content:space-between;align-items:center">Total del carrito<FxIcon name="cart" size={20} /></span>
        <strong class="fx-amount" data-aisle-total>B/.0.00</strong>
        <progress class="fx-meter" id="aisle-meter" max="1" value="0" hidden aria-label="Presupuesto utilizado"></progress>
        <p class="fx-sub" data-aisle-count>0 productos · 0 unidades</p>
        <div class="fx-stats">
          <div class="fx-stat">
            <label for="aisle-budget" style="display:flex;gap:6px;color:var(--fx-muted);font-size:14px">Presupuesto <small>(opcional)</small></label>
            <div class="fx-inline-money"><span aria-hidden="true">B/.</span><input id="aisle-budget" name="budget" form="aisle-form" type="text" inputmode="decimal" autocomplete="off" placeholder="0.00" aria-describedby="budget-help" /></div>
          </div>
          <div class="fx-stat is-accent is-balance"><span>Saldo</span><strong data-aisle-balance>Añade un presupuesto para ver el saldo</strong></div>
        </div>
        <small class="visually-hidden" id="budget-help">Opcional. Puedes cambiarlo durante la compra.</small>
        <p class="fx-overbudget" role="status"><FxIcon name="alert" size={18} />Superaste tu presupuesto.</p>
        <p class="fx-hint" style="display:flex;gap:8px;align-items:center;margin-top:12px"><FxIcon name="info" size={16} /><span data-aisle-hint>Añade productos para ver tu total.</span></p>
      </section>

      <section class="fx-panel aisle-entry" aria-labelledby="aisle-add-title">
        <h2 class="fx-panel-title" id="aisle-add-title">Añadir producto</h2>
        <form id="aisle-form" class="fx-form" novalidate>
          <div>
            <label class="visually-hidden" for="aisle-name">Nombre (opcional)</label>
            <div class="fx-search-field"><FxIcon name="box" size={20} /><input id="aisle-name" name="name" type="text" maxlength="80" autocomplete="off" placeholder="Nombre del producto (opcional)" /></div>
          </div>
          <div class="fx-add-row">
            <div>
              <label class="fx-label" for="aisle-price">Precio unitario</label>
              <div class="fx-money" style="min-height:52px"><span class="fx-prefix" aria-hidden="true" style="font-size:1.1rem">B/.</span><input id="aisle-price" name="price" type="text" inputmode="decimal" autocomplete="off" required placeholder="0.00" style="font-size:1.15rem" /></div>
            </div>
            <div>
              <label class="fx-label" for="aisle-quantity">Cantidad</label>
              <div class="fx-stepper"><button type="button" id="aisle-decrease" aria-label="Disminuir cantidad">−</button><input id="aisle-quantity" name="quantity" type="text" inputmode="decimal" autocomplete="off" required value="1" /><button type="button" id="aisle-increase" aria-label="Aumentar cantidad">+</button></div>
            </div>
          </div>
          <p class="fx-error" id="aisle-error" role="alert" aria-live="assertive"></p>
          <button class="fx-btn is-block" type="submit" disabled><FxIcon name="plus" size={20} />Añadir producto</button>
          <noscript><p class="fx-error">Activa JavaScript para añadir productos. Los datos se calculan en tu navegador.</p></noscript>
          <p class="fx-hint">No se aplica ITBMS, descuento ni recargo automáticamente.</p>
        </form>
      </section>

      <section class="fx-panel aisle-cart" aria-labelledby="aisle-cart-title">
        <h2 class="fx-panel-title" id="aisle-cart-title">Mi carrito <span class="fx-meta" data-aisle-lines>0 productos</span></h2>
        <p class="fx-sub" id="aisle-empty">Agrega tu primer producto para comenzar.</p>
        <ul class="fx-rows fx-aisle-list" id="aisle-list" aria-label="Productos de la compra"></ul>
      </section>

      <section class="fx-panel fx-receipt" aria-labelledby="receipt-title">
        <h2 class="fx-panel-title" id="receipt-title"><span style="display:flex;align-items:center;gap:10px"><FxIcon name="receipt" />Resumen de compra</span></h2>
        <ul class="fx-rows">
          <li><span class="fx-row-label">Unidades</span><strong data-aisle-units>0</strong></li>
          <li><span class="fx-row-label">Presupuesto</span><strong data-aisle-budget-view>Sin presupuesto</strong></li>
          <li><span class="fx-row-label">Saldo restante</span><strong data-aisle-remaining>—</strong></li>
        </ul>
        <div class="fx-receipt-total"><span>TOTAL</span><strong data-aisle-receipt-total>B/.0.00</strong></div>
      </section>

      <div>
        <div class="fx-actions" role="group" aria-label="Acciones de la compra">
          <button class="fx-action" type="button" id="aisle-copy"><FxIcon name="copy" size={20} />Copiar</button>
          <button class="fx-action" type="button" id="aisle-share"><FxIcon name="share" size={20} />Compartir</button>
          <button class="fx-action" type="button" id="aisle-clear" hidden><FxIcon name="reset" size={20} />Reiniciar</button>
        </div>
        <p class="fx-status" id="aisle-action-status" role="status"></p>
      </div>

      <p class="fx-hint" style="display:flex;gap:8px;align-items:flex-start"><FxIcon name="lock" size={16} /><span><strong>Privado por diseño:</strong> productos, precios y presupuesto permanecen únicamente en la memoria de esta pestaña. No usamos almacenamiento local ni servidores.</span></p>
    </div>

    <div class="fx-dock" aria-label="Total acumulado">
      <div class="fx-dock-inner">
        <div><span class="fx-overline">Total acumulado</span><strong data-aisle-dock-total>B/.0.00</strong></div>
        <button class="fx-btn" type="button" id="aisle-dock-add"><FxIcon name="plus" size={20} />Agregar</button>
      </div>
    </div>
  </div>
  <script>
    import { mountAisleMode } from '../../lib/aisle-ui';
    const root = document.querySelector<HTMLElement>('#aisle-mode');
    if (root) {
      let unmount = mountAisleMode(root);
      window.addEventListener('pagehide', () => unmount());
      window.addEventListener('pageshow', event => { if (event.persisted) unmount = mountAisleMode(root); });
    }
  </script>
</Layout>
