---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import MiQuincenaApp from '../../components/MiQuincenaApp.astro';
import { APP_ORIGIN, QUINCENA_MOVED } from '../../data/isolation';
const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}${p.replace(/^\//, '')}`;
const appUrl = `${APP_ORIGIN}/quincena/`;
const schema = { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Mi Quincena', applicationCategory: 'FinanceApplication', operatingSystem: 'Web', ...(QUINCENA_MOVED ? { url: appUrl } : {}), offers: { '@type': 'Offer', price: '0', priceCurrency: 'PAB' } };
---
<Layout title="Calculadora de Quincena y Presupuesto Personal en Panamá | Calcula Panamá" description="Organiza tu quincena, calcula cuánto puedes gastar diariamente y controla gastos, deudas y ahorros hasta tu próximo pago." canonicalPath="/finanzas/mi-quincena/" schema={schema} frameSrc={QUINCENA_MOVED ? APP_ORIGIN : undefined}>
  {QUINCENA_MOVED ? (
    <>
      <header class="page-head container">
        <Breadcrumbs items={[{ label: 'Mi Quincena', path: '/finanzas/mi-quincena/' }]} />
        <span class="eyebrow">Finanzas personales</span>
        <h1>Mi Quincena</h1>
        <p>Un plan claro para el dinero que tienes hoy, hasta tu próximo pago.</p>
        <p><a class="button primary" href={appUrl}>Abrir Mi Quincena</a></p>
      </header>
      <article class="container article" id="quincena-migration" data-app-origin={APP_ORIGIN}>
        <section class="notice" data-migration-panel hidden>
          <h2>Tienes un presupuesto guardado en la dirección anterior</h2>
          <p>Mi Quincena ahora funciona en <strong>{new URL(APP_ORIGIN).host}</strong>, una dirección propia sin publicidad. Traslada tu presupuesto para seguir usándolo: se copia desde este navegador a la nueva dirección, se comprueba que llegó completo y solo entonces se borra de aquí. No pasa por ningún servidor.</p>
          <p><button class="button primary" type="button" data-migration-move>Trasladar mi presupuesto</button> <a class="button secondary" data-migration-download href="#">Descargar una copia</a></p>
          <p role="status" data-migration-status></p>
        </section>
        <section class="notice" data-migration-done hidden>
          <h2>Tu presupuesto ya está en la nueva dirección</h2>
          <p>Este navegador ya no guarda tu presupuesto en la dirección anterior. <a href={appUrl}>Continuar en Mi Quincena</a>.</p>
        </section>
        <h2>Qué puedes hacer</h2>
        <ul>
          <li>Indica cuándo empieza tu período y cuándo vuelves a cobrar, y cuánto dinero tienes hoy.</li>
          <li>Registra gastos y deudas, márcalos como pagados y añade imprevistos.</li>
          <li>Reserva un ahorro y consulta cuánto te queda libre y cuánto puedes gastar por día hasta tu próximo pago.</li>
          <li>Conserva los gastos recurrentes al empezar una nueva quincena.</li>
        </ul>
        <h2>Por qué tiene su propia dirección</h2>
        <p>El presupuesto se guarda solo en tu navegador, en el almacenamiento local de la dirección donde lo usas. Al separar Mi Quincena en <strong>{new URL(APP_ORIGIN).host}</strong>, ningún script de publicidad del sitio principal puede leer esos datos: los navegadores aíslan el almacenamiento de cada dirección. Esa dirección no muestra anuncios, no carga scripts de terceros y no envía tus importes a ningún servidor.</p>
        <h2>Herramientas relacionadas</h2>
        <ul>
          <li><a href={href('/finanzas/calculadora-prestamos/')}>Calculadora de préstamos</a></li>
          <li><a href={href('/finanzas/meta-de-ahorro/')}>Calculadora de metas de ahorro</a></li>
          <li><a href={href('/calculadoras/salario-neto/')}>Calculadora de salario neto</a></li>
        </ul>
      </article>
      <script>
        import { mountMigration } from '../../lib/finance/migration-bridge';
        const root = document.querySelector<HTMLElement>('#quincena-migration');
        if (root) mountMigration(root);
      </script>
    </>
  ) : (
    <MiQuincenaApp blue={href('/blue-flotante.webp')} loanHref={href('/finanzas/calculadora-prestamos/')} breadcrumbs />
  )}
</Layout>
