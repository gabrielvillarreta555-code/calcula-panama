---
import '../styles/global.css';
interface Props { title: string; description: string; canonicalPath?: string; schema?: Record<string, unknown>; }
const { title, description, canonicalPath = Astro.url.pathname, schema } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path.replace(/^\//, '')}`;
const canonical = new URL(canonicalPath.replace(/^\//, ''), Astro.site || Astro.url.origin).toString();
const current = Astro.url.pathname;
const links = [['/', 'Inicio'], ['/calculadoras/salario-neto/', 'Salario neto'], ['/calculadoras/decimo-tercer-mes/', 'Décimo'], ['/calculadoras/liquidacion-laboral/', 'Liquidación']];
---
<!doctype html>
<html lang="es-PA">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#063b50" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:locale" content="es_PA" /><meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary" />
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  <script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem('cp-theme')||''}catch{}</script>
</head>
<body>
  <a class="skip" href="#contenido">Saltar al contenido</a>
  <header class="site-header"><nav class="nav container" aria-label="Navegación principal">
    <a class="brand" href={href('/')}><span class="brand-mark" aria-hidden="true">CP</span><span>Calcula Panamá</span></a>
    <button class="menu-button" type="button" aria-label="Abrir menú" aria-expanded="false">☰</button>
    <div class="nav-links">{links.map(([path,label]) => <a href={href(path)} aria-current={current.endsWith(path) ? 'page' : undefined}>{label}</a>)}</div>
    <button class="icon-button theme-button" type="button" aria-label="Cambiar modo de color">◐</button>
  </nav></header>
  <main id="contenido"><slot /></main>
  <footer class="site-footer"><div class="container">
    <div class="footer-grid"><div><a class="brand" href={href('/')}><span class="brand-mark">CP</span><span>Calcula Panamá</span></a><p class="muted">Herramientas gratuitas y privadas para entender mejor tus cálculos laborales en Panamá.</p></div>
      <div><h3>Calculadoras</h3><a href={href('/calculadoras/salario-neto/')}>Salario neto</a><a href={href('/calculadoras/decimo-tercer-mes/')}>Décimo tercer mes</a><a href={href('/calculadoras/liquidacion-laboral/')}>Liquidación laboral</a></div>
      <div><h3>Información</h3><a href={href('/sobre-nosotros/')}>Sobre nosotros</a><a href={href('/contacto/')}>Contacto</a><a href={href('/privacidad/')}>Privacidad</a><a href={href('/terminos/')}>Términos y condiciones</a></div>
    </div><div class="footer-bottom">© {new Date().getFullYear()} Calcula Panamá · Resultados orientativos, no constituyen asesoría legal, contable ni tributaria.</div>
  </div></footer>
  <script is:inline>
    const root=document.documentElement,menu=document.querySelector('.menu-button'),links=document.querySelector('.nav-links');
    menu?.addEventListener('click',()=>{const open=links?.classList.toggle('open');menu.setAttribute('aria-expanded',String(Boolean(open)))});
    document.querySelector('.theme-button')?.addEventListener('click',()=>{const next=root.dataset.theme==='dark'?'light':'dark';root.dataset.theme=next;try{localStorage.setItem('cp-theme',next)}catch{}});
  </script>
</body></html>
