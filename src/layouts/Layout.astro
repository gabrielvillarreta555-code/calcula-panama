---
import '../styles/global.css';
import '../styles/share.css';
import '../styles/midnight.css';
import fontUrl from '@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url';
import ToolSearch from '../components/ToolSearch.astro';
import { CATEGORIES, SEARCH_INDEX } from '../data/directory';
import Icon from '../components/Icon.astro';
import { ADSENSE, SITE } from '../data/site';
import { ADS_CSP, STRICT_CSP, adsAllowed } from '../data/ad-policy';
import { BUDGET_KEY } from '../data/isolation';

interface Props {
  title: string;
  description: string;
  /** Ruta relativa a la base del sitio, p. ej. `/calculadoras/salario-neto/`. */
  canonicalPath?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  blueShowcase?: boolean;
  /** Obsoleto: la publicidad se decide en src/data/ad-policy.json. Si es true, fuerza la página sin anuncios. */
  disableAds?: boolean;
  /** Único origen que la página puede incrustar en un iframe (p. ej., la app para el traslado). Se añade a la CSP estricta. */
  frameSrc?: string;
}

const { title, description, schema, noindex = false, blueShowcase = false, disableAds = false, frameSrc } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path.replace(/^\//, '')}`;
// La ruta de Astro incluye la base (/calcula-panama/); se elimina para no duplicarla en la URL canónica.
const pathname = Astro.url.pathname;
const relativePath = Astro.props.canonicalPath ?? (pathname.startsWith(base) ? `/${pathname.slice(base.length)}` : pathname);
const siteRoot = Astro.site ?? new URL(base, Astro.url.origin);
const canonical = new URL(relativePath.replace(/^\//, ''), siteRoot).toString();
const isCurrent = (path: string) => (path === '/' ? relativePath === '/' : relativePath.startsWith(path));
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
// Política por página (src/data/ad-policy.json). Sin publicidad, la página aplica la CSP estricta.
const adsense = !disableAds && adsAllowed(relativePath);
---
<!doctype html>
<html lang="es-PA">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#08090C" />
  <meta name="color-scheme" content="dark light" />
  <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
  <style is:inline set:html={`@font-face{font-family:'Inter Tight Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${fontUrl}) format('woff2-variations');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}`} />
  <meta http-equiv="Content-Security-Policy" content={adsense ? ADS_CSP : frameSrc ? `${STRICT_CSP}; frame-src ${new URL(frameSrc).origin}` : STRICT_CSP} />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
  <link rel="manifest" href={href('/site.webmanifest')} />
  <link rel="sitemap" href={href('/sitemap.xml')} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_PA" />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary" />
  {schemas.map(item => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  <script is:inline>try{var t=localStorage.getItem('cp-theme');if(t==='dark'||t==='light')document.documentElement.dataset.theme=t}catch(e){}</script>
  {adsense && (
    // Guardia (CP-ADS-003): AdSense solo se carga si este navegador NO conserva un presupuesto antiguo
    // de Mi Quincena en este origen y si el almacenamiento se puede comprobar. Si no, no hay anuncios en esta visita.
    <script is:inline data-ads-guard define:vars={{ client: ADSENSE.client, legacyKey: BUDGET_KEY }}>
      var clean = false;
      try { clean = window.localStorage.getItem(legacyKey) === null; } catch (e) { clean = false; }
      document.documentElement.dataset.ads = clean ? 'loaded' : 'blocked';
      if (clean) {
        var s = document.createElement('script');
        s.async = true; s.crossOrigin = 'anonymous';
        s.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' + client;
        document.head.appendChild(s);
      }
    </script>
  )}
</head>
<body class:list={[{ 'blue-showcase': blueShowcase }]}>
  <a class="skip" href="#contenido">Saltar al contenido</a>
  <header class="site-header">
    <nav class="nav container" aria-label="Navegación principal">
      <a class="brand wordmark" href={href('/')} aria-label={`${SITE.name}, inicio`}>
        <span class="wordmark-main">CALCULA.</span><span class="wordmark-sub">PANAMÁ</span>
      </a>
      <div class="nav-links" id="menu">
        <p class="menu-label">Categorías</p>
        {CATEGORIES.map(c => <a href={href(`/herramientas/#${c.id}`)}><span class="menu-num">{c.number}</span>{c.label}</a>)}
        <a href={href('/guias/')} aria-current={isCurrent('/guias/') ? 'page' : undefined}><span class="menu-num">—</span>Guías</a>
        <a href={href('/herramientas/')} aria-current={isCurrent('/herramientas/') ? 'page' : undefined}><span class="menu-num">—</span>Todas las herramientas</a>
      </div>
      <button class="icon-button search-button" type="button" aria-label="Buscar una herramienta" aria-expanded="false" aria-controls="site-search"><Icon name="search" size={20} /></button>
      <button class="icon-button theme-button" type="button" aria-label="Cambiar entre modo oscuro y claro"><Icon name="theme" size={20} /></button>
      <button class="icon-button menu-button" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="menu"><Icon name="menu" size={20} /></button>
    </nav>
    <div class="search-panel" id="site-search" hidden>
      <div class="container"><ToolSearch id="header-search" /></div>
    </div>
  </header>
  <script type="application/json" id="tool-index" set:html={JSON.stringify(SEARCH_INDEX.map(item => ({ ...item, p: href(item.p) })))} />

  {adsense && <p class="container legacy-notice" data-legacy-notice hidden>Tienes un presupuesto de Mi Quincena guardado en este navegador en la dirección anterior. <a href={href('/finanzas/mi-quincena/')}>Trasládalo a la nueva dirección</a>; mientras tanto, esta página no muestra publicidad.</p>}
  {adsense && <script is:inline>if (document.documentElement.dataset.ads === 'blocked') { var n = document.querySelector('[data-legacy-notice]'); if (n) n.hidden = false; }</script>}
  <main id="contenido"><slot /></main>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-brand">
        <a class="wordmark" href={href('/')}><span class="wordmark-main">CALCULA.</span><span class="wordmark-sub">PANAMÁ</span></a>
        <p class="footer-studio"><img src={href('/blue-flotante.webp')} alt="" width="28" height="34" loading="lazy" /> Una plataforma de Blue Lab Studios</p>
      </div>
      <div class="footer-grid">
        {CATEGORIES.map(c => (
          <div>
            <h2>{c.label}</h2>
            {c.tools.map(tool => <a href={href(tool.path)}>{tool.title.replace(/^Calculadora (de |del )?/, '').replace(/^./, m => m.toUpperCase())}</a>)}
          </div>
        ))}
        <div>
          <h2>Calcula Panamá</h2>
          <a href={href('/herramientas/')}>Todas las herramientas</a>
          <a href={href('/compras/')}>Compras y gastos</a>
          <a href={href('/guias/')}>Guías</a>
          <a href={href('/sobre-nosotros/')}>Sobre nosotros</a>
          <a href={href('/contacto/')}>Contacto</a>
          <a href={href('/privacidad/')}>Privacidad</a>
          <a href={href('/terminos/')}>Términos y condiciones</a>
        </div>
      </div>
      <p class="footer-bottom">Creado por <a class="footer-author" href="https://gabrielvillarreta555-code.github.io/" rel="author">Gabriel Villarreta · Blue Lab Studios</a>.<br>© {new Date().getFullYear()} {SITE.name}. Resultados orientativos: no constituyen asesoría legal, contable ni tributaria. No somos una entidad del Gobierno de Panamá.</p>
    </div>
  </footer>

  <nav class="tabbar" aria-label="Accesos rápidos">
    <a href={href('/')} aria-current={relativePath === '/' ? 'page' : undefined}><Icon name="home" size={22} /><span>Inicio</span></a>
    <a href={href('/calculadoras/salario-neto/')} aria-current={isCurrent('/calculadoras/salario-neto/') ? 'page' : undefined}><Icon name="salary" size={22} /><span>Salario</span></a>
    <a href={href('/calculadoras/decimo-tercer-mes/')} aria-current={isCurrent('/calculadoras/decimo-tercer-mes/') ? 'page' : undefined}><Icon name="thirteenth" size={22} /><span>Décimo</span></a>
    <a href={href('/herramientas/')} aria-current={isCurrent('/herramientas/') ? 'page' : undefined}><Icon name="spark" size={22} /><span>Herramientas</span></a>
    <a href={href('/guias/')} aria-current={isCurrent('/guias/') ? 'page' : undefined}><Icon name="book" size={22} /><span>Guías</span></a>
  </nav>

  <script is:inline>
    (function(){
      var root=document.documentElement,menu=document.querySelector('.menu-button'),links=document.getElementById('menu');
      if(menu&&links){
        menu.addEventListener('click',function(){var open=links.classList.toggle('open');menu.setAttribute('aria-expanded',String(open));menu.setAttribute('aria-label',open?'Cerrar menú':'Abrir menú')});
        document.addEventListener('keydown',function(e){if(e.key==='Escape'&&links.classList.contains('open')){links.classList.remove('open');menu.setAttribute('aria-expanded','false');menu.focus()}});
      }
      var sb=document.querySelector('.search-button'),panel=document.getElementById('site-search');
      if(sb&&panel){
        sb.addEventListener('click',function(){var open=panel.hidden;panel.hidden=!open;sb.setAttribute('aria-expanded',String(open));if(open){var i=panel.querySelector('input');if(i)i.focus()}});
        document.addEventListener('keydown',function(e){if(e.key==='Escape'&&!panel.hidden){panel.hidden=true;sb.setAttribute('aria-expanded','false');sb.focus()}});
      }
      var theme=document.querySelector('.theme-button');
      if(theme)theme.addEventListener('click',function(){
        var dark=root.dataset.theme!=='light';
        var next=dark?'light':'dark';root.dataset.theme=next;try{localStorage.setItem('cp-theme',next)}catch(e){}
      });
    })();
  </script>
</body>
</html>
