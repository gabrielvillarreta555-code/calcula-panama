---
import '../styles/global.css';
import '../styles/share.css';
import '../styles/functional.css';
import '../styles/editorial.css';
import FxHeader from '../components/fx/FxHeader.astro';
import FxFooter from '../components/fx/FxFooter.astro';
import { ADSENSE, SITE } from '../data/site';
import { ADS_CSP, STRICT_CSP, adsAllowed } from '../data/ad-policy';
import { BUDGET_KEY } from '../data/isolation';

interface Props {
  title: string;
  description: string;
  /** Ruta relativa a la base del sitio, p. ej. `/calculadoras/salario-neto/`. */
  canonicalPath?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  /** Midnight Functional (CP-DESIGN-007) o portada editorial (CP-DESIGN-006, slots «masthead» y «colophon»): cabecera, pie y estilos funcionales. Solo en las herramientas autorizadas. */
  variant?: 'functional' | 'editorial';
  /** Obsoleto: la publicidad se decide en src/data/ad-policy.json. Si es true, fuerza la página sin anuncios. */
  disableAds?: boolean;
  /** Único origen que la página puede incrustar en un iframe (p. ej., la app para el traslado). Se añade a la CSP estricta. */
  frameSrc?: string;
}

const { title, description, schema, noindex = false, disableAds = false, frameSrc, variant } = Astro.props;
// CP-DESIGN-008: todo el sitio usa Midnight Edition. Editorial (portada, guías, categorías e información) con cabecera
// y colofón propios en los slots «masthead» y «colophon»; Functional (herramientas) en cualquier otro caso.
const editorial = variant === 'editorial';
const functional = !editorial;
const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path.replace(/^\//, '')}`;
// La ruta de Astro incluye la base (/calcula-panama/); se elimina para no duplicarla en la URL canónica.
const pathname = Astro.url.pathname;
const relativePath = Astro.props.canonicalPath ?? (pathname.startsWith(base) ? `/${pathname.slice(base.length)}` : pathname);
const siteRoot = Astro.site ?? new URL(base, Astro.url.origin);
const canonical = new URL(relativePath.replace(/^\//, ''), siteRoot).toString();
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
// Política por página (src/data/ad-policy.json). Sin publicidad, la página aplica la CSP estricta.
const adsense = !disableAds && adsAllowed(relativePath);
---
<!doctype html>
<html lang="es-PA">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#08090C" />
  <meta name="color-scheme" content="dark" />
  <meta http-equiv="Content-Security-Policy" content={adsense ? ADS_CSP : frameSrc ? `${STRICT_CSP}; frame-src ${new URL(frameSrc).origin}` : STRICT_CSP} />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
  <link rel="manifest" href={href('/site.webmanifest')} />
  <link rel="sitemap" href={href('/sitemap.xml')} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_PA" />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary" />
  {schemas.map(item => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  {adsense && (
    // Guardia (CP-ADS-003): AdSense solo se carga si este navegador NO conserva un presupuesto antiguo
    // de Mi Quincena en este origen y si el almacenamiento se puede comprobar. Si no, no hay anuncios en esta visita.
    <script is:inline data-ads-guard define:vars={{ client: ADSENSE.client, legacyKey: BUDGET_KEY }}>
      var clean = false;
      try { clean = window.localStorage.getItem(legacyKey) === null; } catch (e) { clean = false; }
      document.documentElement.dataset.ads = clean ? 'loaded' : 'blocked';
      if (clean) {
        var s = document.createElement('script');
        s.async = true; s.crossOrigin = 'anonymous';
        s.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' + client;
        document.head.appendChild(s);
      }
    </script>
  )}
</head>
<body class:list={[{ fx: functional, ed: editorial }]}>
  <a class="skip" href="#contenido">Saltar al contenido</a>
  {functional && <FxHeader />}
  {editorial && <slot name="masthead" />}

  {adsense && <p class="container legacy-notice" data-legacy-notice hidden>Tienes un presupuesto de Mi Quincena guardado en este navegador en la dirección anterior. <a href={href('/finanzas/mi-quincena/')}>Trasládalo a la nueva dirección</a>; mientras tanto, esta página no muestra publicidad.</p>}
  {adsense && <script is:inline>if (document.documentElement.dataset.ads === 'blocked') { var n = document.querySelector('[data-legacy-notice]'); if (n) n.hidden = false; }</script>}
  <main id="contenido"><slot /></main>


  {functional && <FxFooter />}
  {editorial && <slot name="colophon" />}

</body>
</html>
