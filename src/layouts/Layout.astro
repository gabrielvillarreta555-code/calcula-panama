---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { ADSENSE, CALCULATORS, SITE, isAdsenseEnabled } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Ruta relativa a la base del sitio, p. ej. `/calculadoras/salario-neto/`. */
  canonicalPath?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, schema, noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path.replace(/^\//, '')}`;
// La ruta de Astro incluye la base (/calcula-panama/); se elimina para no duplicarla en la URL canónica.
const pathname = Astro.url.pathname;
const relativePath = Astro.props.canonicalPath ?? (pathname.startsWith(base) ? `/${pathname.slice(base.length)}` : pathname);
const siteRoot = Astro.site ?? new URL(base, Astro.url.origin);
const canonical = new URL(relativePath.replace(/^\//, ''), siteRoot).toString();
const isCurrent = (path: string) => (path === '/' ? relativePath === '/' : relativePath.startsWith(path));
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const adsense = isAdsenseEnabled();
---
<!doctype html>
<html lang="es-PA">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#0b3d52" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0b1a20" media="(prefers-color-scheme: dark)" />
  <meta name="color-scheme" content="light dark" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
  <link rel="manifest" href={href('/site.webmanifest')} />
  <link rel="sitemap" href={href('/sitemap-index.xml')} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_PA" />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary" />
  {schemas.map(item => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  <script is:inline>try{var t=localStorage.getItem('cp-theme');if(t==='dark'||t==='light')document.documentElement.dataset.theme=t}catch(e){}</script>
  {adsense && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE.client}`} crossorigin="anonymous"></script>}
</head>
<body>
  <a class="skip" href="#contenido">Saltar al contenido</a>
  <header class="site-header">
    <nav class="nav container" aria-label="Navegación principal">
      <a class="brand" href={href('/')} aria-label={`${SITE.name}, inicio`}>
        <span class="brand-mark" aria-hidden="true"><span></span></span>
        <span class="brand-name">Calcula<b>Panamá</b></span>
      </a>
      <div class="nav-links" id="menu">
        {CALCULATORS.map(item => <a href={href(item.path)} aria-current={isCurrent(item.path) ? 'page' : undefined}>{item.label}</a>)}
        <a href={href('/guias/')} aria-current={isCurrent('/guias/') ? 'page' : undefined}>Guías</a>
      </div>
      <button class="icon-button theme-button" type="button" aria-label="Cambiar entre modo claro y oscuro"><Icon name="theme" size={20} /></button>
      <button class="icon-button menu-button" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="menu"><Icon name="menu" size={20} /></button>
    </nav>
  </header>

  <main id="contenido"><slot /></main>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div>
          <a class="brand" href={href('/')}><span class="brand-mark" aria-hidden="true"><span></span></span><span class="brand-name">Calcula<b>Panamá</b></span></a>
          <p class="muted">Calculadoras laborales gratuitas y privadas para Panamá. Los cálculos se hacen en tu teléfono y explicamos cada fórmula con su base legal.</p>
        </div>
        <div>
          <h2>Calculadoras</h2>
          {CALCULATORS.map(item => <a href={href(item.path)}>{item.label}</a>)}
        </div>
        <div>
          <h2>Información</h2>
          <a href={href('/guias/')}>Guías</a>
          <a href={href('/sobre-nosotros/')}>Sobre nosotros</a>
          <a href={href('/contacto/')}>Contacto</a>
          <a href={href('/privacidad/')}>Privacidad</a>
          <a href={href('/terminos/')}>Términos y condiciones</a>
        </div>
      </div>
      <p class="footer-bottom">Creado por <a class="footer-author" href="https://gabrielvillarreta555-code.github.io/" rel="author">Gabriel Villarreta · Blue Lab Studios</a>.<br>© {new Date().getFullYear()} {SITE.name}. Resultados orientativos: no constituyen asesoría legal, contable ni tributaria. No somos una entidad del Gobierno de Panamá.</p>
    </div>
  </footer>

  <nav class="tabbar" aria-label="Calculadoras">
    <a href={href('/')} aria-current={relativePath === '/' ? 'page' : undefined}><Icon name="home" size={22} /><span>Inicio</span></a>
    {CALCULATORS.map(item => <a href={href(item.path)} aria-current={isCurrent(item.path) ? 'page' : undefined}><Icon name={item.icon} size={22} /><span>{item.short}</span></a>)}
  </nav>

  <script is:inline>
    (function(){
      var root=document.documentElement,menu=document.querySelector('.menu-button'),links=document.getElementById('menu');
      if(menu&&links){
        menu.addEventListener('click',function(){var open=links.classList.toggle('open');menu.setAttribute('aria-expanded',String(open));menu.setAttribute('aria-label',open?'Cerrar menú':'Abrir menú')});
        document.addEventListener('keydown',function(e){if(e.key==='Escape'&&links.classList.contains('open')){links.classList.remove('open');menu.setAttribute('aria-expanded','false');menu.focus()}});
      }
      var theme=document.querySelector('.theme-button');
      if(theme)theme.addEventListener('click',function(){
        var dark=root.dataset.theme?root.dataset.theme==='dark':matchMedia('(prefers-color-scheme: dark)').matches;
        var next=dark?'light':'dark';root.dataset.theme=next;try{localStorage.setItem('cp-theme',next)}catch(e){}
      });
    })();
  </script>
</body>
</html>
