---
import { LEGAL_PARAMETERS, OFFICIAL_SOURCES } from '../data/legal';
---
<section aria-labelledby="fuentes"><h2 id="fuentes">Fuentes y vigencia</h2>
  <div class="legal-meta"><span class="tag">Parámetros revisados: {LEGAL_PARAMETERS.reviewedOn}</span><span class="tag">Jurisdicción: Panamá</span></div>
  <ul class="source-list">{OFFICIAL_SOURCES.map(source => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.institution}: {source.title}</a></li>)}</ul>
  <p class="callout-warning"><strong>Importante:</strong> la normativa, criterios administrativos y condiciones particulares pueden cambiar el resultado. Contrasta el cálculo con tu comprobante, la institución competente o un profesional.</p>
</section>
