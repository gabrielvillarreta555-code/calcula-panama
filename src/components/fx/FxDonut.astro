---
/** Gráfico circular de proporción (CP-DESIGN-007). El script de la página fija `--fx-value` (0–100) y el texto. */
interface Props { id: string; label: string; value?: number; caption?: string }
const { id, label, value = 0, caption = '' } = Astro.props;
---
<figure class="fx-donut" id={id} style={`--fx-value:${value}`} role="img" aria-label={label}>
  <svg viewBox="0 0 100 100" aria-hidden="true"><circle class="fx-donut-track" cx="50" cy="50" r="42" pathLength="100" /><circle class="fx-donut-value" cx="50" cy="50" r="42" pathLength="100" /></svg>
  <figcaption><strong data-donut-value>{value ? `${value}%` : '—'}</strong><span>{caption}</span></figcaption>
</figure>
