---
/** Pie Midnight Functional (CP-DESIGN-007). */
import { SITE } from '../../data/site';
const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}${p.replace(/^\//, '')}`;
---
<footer class="fx-footer">
  <div class="fx-wrap">
    <nav aria-label="Enlaces del sitio">
      <a href={href('/herramientas/')}>Herramientas</a><a href={href('/guias/')}>Guías</a><a href={href('/sobre-nosotros/')}>Sobre nosotros</a><a href={href('/contacto/')}>Contacto</a><a href={href('/privacidad/')}>Privacidad</a><a href={href('/terminos/')}>Términos</a>
    </nav>
    <p>CALCULA PANAMÁ · Blue Lab Studios. © {new Date().getFullYear()} {SITE.name}. Resultados orientativos: no constituyen asesoría legal, contable ni tributaria. No somos una entidad del Gobierno de Panamá.</p>
  </div>
</footer>
