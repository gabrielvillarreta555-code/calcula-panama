---
/**
 * Guía rápida en texto (CP-DESIGN-008): sustituye la ayuda contextual que antes daba Blue, con el mismo contenido
 * (src/data/blue-help.ts) y el componente plegable aprobado (fx-details). Sin personaje ni animaciones.
 */
import FxIcon from './FxIcon.astro';
import { BLUE_GUIDES } from '../../data/blue-help';
interface Props { guide: keyof typeof BLUE_GUIDES }
const g = BLUE_GUIDES[Astro.props.guide];
---
<details class="fx-details fx-guide" data-guide={Astro.props.guide}>
  <summary><FxIcon name="info" size={18} />Guía rápida: {g.title.replace(/^Guía (de |del )?/i, '').replace(/^./, c => c.toUpperCase())}<span class="fx-chev"><FxIcon name="chevronDown" size={18} /></span></summary>
  <div class="fx-details-body">
    <p class="fx-sub">{g.intro}</p>
    <ol class="fx-guide-steps">{g.topics.map(t => <li><strong>{t.title.replace(/^\d+\.\s*/, '')}</strong><span>{t.text}</span></li>)}</ol>
    <p class="fx-hint">{g.resultHint}</p>
  </div>
</details>
