---
import type { BlueGuide } from '../data/blue-help';
import BlueCharacter from './BlueCharacter.astro';
interface Props { guide: BlueGuide }
const { guide } = Astro.props;
---
<div class="container blue-help-area">
<button class="blue-visibility" type="button" hidden>Ocultar a Blue</button>
<details class="blue-help" id="blue-help">
  <summary aria-label="¿Necesitas ayuda? Abrir guía de Blue">
    <span class="blue-help-bubble" aria-hidden="true">¿Necesitas ayuda?</span>
    <BlueCharacter id="blue-help-character" />
  </summary>
  <section class="blue-help-content" aria-label={guide.title}>
    <div class="blue-help-header"><div><strong>Blue te orienta</strong><span>{guide.title}</span></div><button class="blue-help-close" type="button" aria-label="Cerrar ayuda de Blue" hidden>×</button></div>
    <p>{guide.intro}</p>
    <p class="blue-help-scroll-hint">Elige un tema y desliza dentro de esta ventana para ver los demás.</p>
    <p class="blue-help-context" aria-live="polite" hidden></p>
    <div class="blue-help-topics">
      {guide.topics.map((topic, index) => (
        <details class="blue-help-topic" open={index === 0} data-blue-field={topic.target} data-blue-hint={topic.focusHint}>
          <summary>{topic.title}</summary>
          <p>{topic.text}</p>
          {topic.target && <a href={`#${topic.target}`} data-blue-target={topic.target}>{topic.targetLabel}</a>}
        </details>
      ))}
    </div>
    <p class="blue-help-note">Esta ayuda no lee ni envía los datos del formulario. El resultado es orientativo y puede variar según tu situación.</p>
    <a class="blue-help-sources" href="#fuentes">Consultar fuentes y vigencia</a>
  </section>
</details>
</div>
<script>
  import { mountBlue } from '../lib/blue/living';
  const guide = document.querySelector<HTMLDetailsElement>('#blue-help');
  if (guide) {
    let unmount = mountBlue(guide);
    window.addEventListener('pagehide', () => unmount());
    window.addEventListener('pageshow', event => { if (event.persisted) unmount = mountBlue(guide); });
    const trigger = guide.querySelector<HTMLElement>(':scope > summary');
    const close = guide.querySelector<HTMLButtonElement>('.blue-help-close');
    const context = guide.querySelector<HTMLElement>('.blue-help-context');
    if (close) {
      close.hidden = false;
      close.addEventListener('click', () => { guide.open = false; trigger?.focus(); });
    }
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && guide.open) { guide.open = false; trigger?.focus(); }
    });
    guide.querySelectorAll<HTMLAnchorElement>('[data-blue-target]').forEach((link) => {
      link.addEventListener('click', (event) => {
        const target = document.getElementById(link.dataset.blueTarget || '');
        if (!target) return;
        event.preventDefault();
        guide.open = false;
        target.focus({ preventScroll: true });
        target.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'center' });
      });
    });
    guide.querySelector<HTMLAnchorElement>('.blue-help-sources')?.addEventListener('click', () => { guide.open = false; });
    document.querySelector('form')?.addEventListener('focusin', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement) || !target.id || !context) return;
      const topic = Array.from(guide.querySelectorAll<HTMLElement>('[data-blue-field]')).find((item) => item.dataset.blueField === target.id);
      context.textContent = topic?.dataset.blueHint || '';
      context.hidden = !context.textContent;
    });
  }
</script>
