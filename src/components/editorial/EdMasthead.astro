---
/** Cabecera editorial de Midnight Edition (CP-DESIGN-006), compartida por la portada y las páginas editoriales (CP-DESIGN-008). */
import { SITE } from '../../data/site';
interface Props { home?: boolean }
const { home = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}${p.replace(/^\//, '')}`;
// En la portada las secciones son anclas locales; en el resto llevan a la sección de la portada.
const prefix = home ? '' : href('/');
---
<div class="wrap">
  <div class="rail"><span class="label">Calcula Panamá — Edición Midnight</span><span class="label">Panamá · {new Date().getFullYear()}</span></div>
  <header class="masthead">
    <a class="wordmark" href={href('/')} aria-label={`${SITE.name}, inicio`}><b>CALCULA.</b><small>PANAMÁ</small></a>
    <nav aria-label="Secciones" class="sections">
      <a href={`${prefix}#movilidad`}>Movilidad</a><a href={`${prefix}#finanzas`}>Finanzas</a><a href={`${prefix}#trabajo`}>Trabajo</a><a href={`${prefix}#hogar`}>Hogar</a><a href={`${prefix}#educacion`}>Educación</a><a href={`${prefix}#revista`}>Revista</a>
    </nav>
    <div class="tools"><button type="button" data-open aria-controls="overlay" aria-expanded="false">Buscar</button><button type="button" data-open aria-controls="overlay" aria-expanded="false">Índice</button></div>
  </header>
</div>
