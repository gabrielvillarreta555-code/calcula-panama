---
/** Imagen de la portada editorial (CP-DESIGN-006): AVIF y WebP en 800 y 1600 px, como en el prototipo. */
interface Props { name: string; dir?: 'editorial' | 'fotos'; alt: string; ratio?: string; height?: number; eager?: boolean; sizes?: string }
const { name, dir = 'editorial', alt, ratio, height = 900, eager = false, sizes = '(min-width: 980px) 60vw, 100vw' } = Astro.props;
const base = import.meta.env.BASE_URL;
const src = (w: number, ext: string) => `${base}${dir}/${name}-${w}.${ext}`;
---
<picture>
  <source type="image/avif" srcset={`${src(800, 'avif')} 800w, ${src(1600, 'avif')} 1600w`} sizes={sizes} />
  <img src={src(1600, 'webp')} srcset={`${src(800, 'webp')} 800w, ${src(1600, 'webp')} 1600w`} sizes={sizes} alt={alt} width="1600" height={height}
    style={ratio ? `aspect-ratio:${ratio}` : undefined} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" />
</picture>
