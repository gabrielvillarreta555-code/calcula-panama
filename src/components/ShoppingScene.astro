---
const blue = `${import.meta.env.BASE_URL}blue-flotante.webp`;
---
<div class="shopping-scene" aria-hidden="true">
  <div class="shopping-scene-halo"></div>
  <svg class="shopping-scene-cart" viewBox="0 0 310 230" fill="none" focusable="false">
    <ellipse cx="161" cy="207" rx="120" ry="12" fill="#0b3871" opacity=".12" />
    <path d="M35 53h27l21 105c2 11 11 18 22 18h119" stroke="#174683" stroke-width="9" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M72 85h181l-19 57c-3 10-12 17-23 17H89" fill="#eaf4ff" stroke="#174683" stroke-width="8" stroke-linejoin="round" />
    <path d="M107 87l5 69m37-69 1 69m38-69-4 69m38-69-11 69" stroke="#9dbce4" stroke-width="4" />
    <circle cx="112" cy="194" r="11" fill="#174683" /><circle cx="211" cy="194" r="11" fill="#174683" />
    <rect x="91" y="40" width="36" height="50" rx="6" fill="#75bdff" /><path d="M99 53h20M99 63h20" stroke="#1555a0" stroke-width="3" stroke-linecap="round" />
    <path d="M144 44h37l5 47h-47z" fill="#3e95e8" /><path d="M149 44l4-12h20l4 12" fill="#a4d9ff" /><circle cx="162" cy="68" r="8" fill="#eaf6ff" />
    <path d="M198 53c-11-15 2-26 13-16 9-13 23-1 13 13l-11 12z" fill="#2684cd" /><rect x="199" y="59" width="28" height="31" rx="5" fill="#9fd6ff" />
  </svg>
  <img class="shopping-scene-blue" src={blue} alt="" width="360" height="432" loading="lazy" />
  <span class="shopping-spark shopping-spark-one">✦</span><span class="shopping-spark shopping-spark-two">✦</span>
</div>
