---
/**
 * Buscador de herramientas (CP-DESIGN-005). Filtra en el navegador el índice que publica Layout
 * (#tool-index); no envía lo que escribes a ningún servidor. Funciona en la cabecera y en la portada.
 */
import Icon from './Icon.astro';
interface Props { id: string; label?: string; placeholder?: string }
const { id, label = 'Buscar una herramienta', placeholder = '¿Qué necesitas calcular?' } = Astro.props;
---
<div class="tool-search" data-tool-search>
  <form role="search" action={`${import.meta.env.BASE_URL}herramientas/`} method="get">
    <label class="visually-hidden" for={id}>{label}</label>
    <span class="tool-search-field"><Icon name="search" size={20} /><input id={id} name="q" type="search" autocomplete="off" spellcheck="false" placeholder={placeholder} aria-describedby={`${id}-status`} /></span>
  </form>
  <p class="visually-hidden" id={`${id}-status`} role="status" aria-live="polite"></p>
  <ul class="tool-search-results" hidden></ul>
</div>
<script>
  type Entry = { t: string; d: string; p: string; c: string; k: string };
  const normalize = (text: string) => text.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
  let index: (Entry & { n: string })[] | null = null;
  const load = () => {
    if (index) return index;
    try { index = (JSON.parse(document.getElementById('tool-index')?.textContent ?? '[]') as Entry[]).map(e => ({ ...e, n: normalize(`${e.t} ${e.d} ${e.c} ${e.k}`) })); }
    catch { index = []; }
    return index;
  };
  document.querySelectorAll<HTMLElement>('[data-tool-search]').forEach(root => {
    const input = root.querySelector('input')!, list = root.querySelector('ul')!, status = root.querySelector<HTMLElement>('[role=status]')!;
    const render = () => {
      const words = normalize(input.value).split(/\s+/).filter(Boolean);
      list.replaceChildren();
      if (!words.length) { list.hidden = true; status.textContent = ''; return; }
      // Primero las herramientas cuyo título contiene lo buscado; después el resto de coincidencias.
      const inTitle = (e: { t: string }) => words.every(w => normalize(e.t).includes(w));
      const hits = load().filter(e => words.every(w => e.n.includes(w))).sort((a, b) => Number(inTitle(b)) - Number(inTitle(a))).slice(0, 8);
      for (const hit of hits) {
        const li = document.createElement('li'), a = document.createElement('a'), small = document.createElement('small');
        a.href = hit.p; a.textContent = hit.t; small.textContent = hit.c; a.append(small); li.append(a); list.append(li);
      }
      if (!hits.length) { const li = document.createElement('li'); li.className = 'tool-search-empty'; li.textContent = 'Sin resultados. Prueba con otra palabra o revisa todas las herramientas.'; list.append(li); }
      list.hidden = false;
      status.textContent = hits.length ? `${hits.length} resultado${hits.length === 1 ? '' : 's'}` : 'Sin resultados';
    };
    input.addEventListener('input', render);
    input.addEventListener('keydown', event => {
      if (event.key === 'Enter') { const first = list.querySelector('a'); if (first) { event.preventDefault(); location.href = first.href; } }
      if (event.key === 'ArrowDown') { const first = list.querySelector('a'); if (first) { event.preventDefault(); first.focus(); } }
    });
    list.addEventListener('keydown', event => {
      const links = [...list.querySelectorAll('a')]; const i = links.indexOf(document.activeElement as HTMLAnchorElement);
      if (event.key === 'ArrowDown' && i < links.length - 1) { event.preventDefault(); links[i + 1]!.focus(); }
      if (event.key === 'ArrowUp') { event.preventDefault(); (i > 0 ? links[i - 1]! : input).focus(); }
    });
  });
</script>
