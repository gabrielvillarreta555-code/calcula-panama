---
/**
 * Plantilla del origen de la app (app.calculapanama.com). Reglas: nunca publicidad, analítica ni
 * scripts o recursos de terceros; CSP estricta; noindex (es una aplicación, no contenido nuevo).
 */
import '../../src/styles/global.css';
import '../../src/styles/share.css';
import '../../src/styles/functional.css';
import { STRICT_CSP } from '../../src/data/ad-policy';
import { MAIN_ORIGIN } from '../../src/data/isolation';
interface Props { title: string; description?: string; bare?: boolean }
const { title, description = 'Mi Quincena, de Calcula Panamá.', bare = false } = Astro.props;
const main = (path: string) => `${MAIN_ORIGIN}${path}`;
---
<!doctype html>
<html lang="es-PA">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="color-scheme" content="light dark" />
  <meta http-equiv="Content-Security-Policy" content={STRICT_CSP} />
  <meta name="referrer" content="no-referrer" />
  <meta name="robots" content="noindex" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <script is:inline>try{var t=localStorage.getItem('cp-theme');if(t==='dark'||t==='light')document.documentElement.dataset.theme=t}catch(e){}</script>
</head>
<body class="fx">
  {!bare && (
    <header class="fx-header"><div class="fx-wrap fx-header-bar"><a class="fx-wordmark" href={main('/')} aria-label="Calcula Panamá, inicio">CALCULA.</a></div></header>
  )}
  <main id="contenido"><slot /></main>
  {!bare && (
    <footer class="fx-footer"><div class="fx-wrap"><nav aria-label="Enlaces"><a href={main('/privacidad/')}>Privacidad</a><a href={main('/terminos/')}>Términos</a><a href={main('/contacto/')}>Contacto</a></nav><p>Mi Quincena es parte de Calcula Panamá, de Blue Lab Studios. Esta dirección no muestra publicidad ni carga scripts de terceros.</p></div></footer>
  )}
</body>
</html>
