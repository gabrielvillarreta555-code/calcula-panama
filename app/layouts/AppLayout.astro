---
/**
 * Plantilla del origen de la app (app.calculapanama.com). Reglas: nunca publicidad, analítica ni
 * scripts o recursos de terceros; CSP estricta; noindex (es una aplicación, no contenido nuevo).
 */
import '../../src/styles/global.css';
import '../../src/styles/share.css';
import '../../src/styles/midnight.css';
import fontUrl from '@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url';
import { STRICT_CSP } from '../../src/data/ad-policy';
import { MAIN_ORIGIN } from '../../src/data/isolation';
interface Props { title: string; description?: string; bare?: boolean }
const { title, description = 'Mi Quincena, de Calcula Panamá.', bare = false } = Astro.props;
const main = (path: string) => `${MAIN_ORIGIN}${path}`;
---
<!doctype html>
<html lang="es-PA">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="color-scheme" content="dark light" />
  <meta name="theme-color" content="#08090C" />
  <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
  <style is:inline set:html={`@font-face{font-family:'Inter Tight Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${fontUrl}) format('woff2-variations')}`} />
  <meta http-equiv="Content-Security-Policy" content={STRICT_CSP} />
  <meta name="referrer" content="no-referrer" />
  <meta name="robots" content="noindex" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <script is:inline>try{var t=localStorage.getItem('cp-theme');if(t==='dark'||t==='light')document.documentElement.dataset.theme=t}catch(e){}</script>
</head>
<body>
  {!bare && (
    <header class="site-header">
      <nav class="nav container" aria-label="Navegación principal">
        <a class="wordmark" href={main('/')} aria-label="Calcula Panamá, inicio"><span class="wordmark-main">CALCULA.</span><span class="wordmark-sub">PANAMÁ</span></a>
      </nav>
    </header>
  )}
  <main id="contenido"><slot /></main>
  {!bare && (
    <footer class="site-footer">
      <div class="container">
        <p class="footer-bottom">Mi Quincena es parte de <a href={main('/')}>Calcula Panamá</a>, de Blue Lab Studios. Esta dirección no muestra publicidad ni carga scripts de terceros. <a href={main('/privacidad/')}>Privacidad</a> · <a href={main('/terminos/')}>Términos</a> · <a href={main('/contacto/')}>Contacto</a></p>
      </div>
    </footer>
  )}
</body>
</html>
